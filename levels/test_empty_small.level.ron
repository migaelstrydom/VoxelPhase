// Minimal terrain fixture: one segment, one crater, no objects.
Level(
    name: "Test Empty Terrain",

    segments: [
        (
            name: "main",

            terrain: Terrain(
                voxel_size: 1.0,
                // Chunks are 32 voxels on a side; keeping bounds on that lattice avoids
                // partially-filled edge chunks.
                bounds: (min: (-8.0, -8.0, -8.0), max: (8.0, 8.0, 8.0)),
                base_height: 0.0,
                material_layers: [
                    (depth: 1.0,  material: Grass),
                    (depth: 4.0,  material: Dirt),
                    (depth: 999.0, material: Rock),
                ],
                features: [
                    //TerrainRoughness(frequency: 0.1, amplitude: 3.0, octaves: 3, seed: 42),
                    //Crater(center: (-10.0, -1.0), radius: 20.0, depth: 5.0),
                ],
            ),
        ),
    ],

    placements: [
        Root(segment: "main"),
    ],

    player_spawn: (3.0, 2.0, 0.0),
)
