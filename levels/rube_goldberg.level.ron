// Rube Goldberg — Expert difficulty.
// A precision puzzle level. Each section requires triggering a chain
// reaction to open the path forward. Limited space, tight timing,
// and creative use of physics. Every grenade counts.
//
// Layout (top-down):
//
//   [Spawn Platform]
//        |
//   [Seesaw Puzzle] — grenade one end to launch crate onto pressure ledge
//        |
//   [Domino Alley] — topple a tower to knock open a crate wall
//        |
//   [Bowling Section] — launch beach ball to clear crate pins
//        |
//   [Vertical Climb] — stack crates on pillars to reach the goal
//        |
//   [Goal Island]
//
Level(
    name: "Rube Goldberg",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -12.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 2.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // === Section 1: Spawn Platform ===
            Plateau(min: (-10.0, -6.0), max: (-2.0, 6.0), height: 0.0),

            // === Section 2: Seesaw Arena ===
            Plateau(min: (-2.0, -8.0), max: (10.0, 8.0), height: -4.0),
            // Raised ledge — crate must land here to "open" the path
            Wall(from: (8.0, -3.0), to: (8.0, 3.0), height: -1.0, thickness: 2.0),

            // === Section 3: Domino Alley ===
            // Narrow corridor
            Plateau(min: (10.0, -2.0), max: (24.0, 2.0), height: -4.0),
            // Walls on the sides to keep things channeled
            Wall(from: (10.0, -2.0), to: (24.0, -2.0), height: -1.0, thickness: 0.5),
            Wall(from: (10.0, 2.0), to: (24.0, 2.0), height: -1.0, thickness: 0.5),

            // === Section 4: Bowling Arena ===
            Plateau(min: (24.0, -8.0), max: (36.0, 8.0), height: -4.0),

            // === Section 5: Vertical Climb ===
            Plateau(min: (36.0, -4.0), max: (42.0, 4.0), height: -4.0),

            // Ramp connecting seesaw to spawn (so player can walk down)
            Ramp(from: (-2.0, 0.0), to: (0.0, 0.0), start_height: 0.0, end_height: -4.0, width: 4.0),

            TerrainRoughness(frequency: 0.1, amplitude: 0.15, octaves: 2, seed: 606),
        ],

        volumes: [
            // === Goal island floating above the climb section ===
            Island(center: (40.0, 6.0, 0.0), half_extents: (3.0, 1.0, 3.0), edge_noise: 0.2),

            // Pillars in the vertical climb section
            Pillar(center: (37.0, 0.0), height: 6.0, radius: 1.2),
            Pillar(center: (39.0, -2.0), height: 8.0, radius: 1.0),
            Pillar(center: (41.0, 2.0), height: 10.0, radius: 1.0),
        ],
    ),

    player_spawn: (-7.0, 2.0, 0.0),

    objects: [
        // === SPAWN PLATFORM ===
        // Minimal supplies — every item matters
        Crate(pos: (-5.0, 1.0, 2.0), size: 0.5),
        BeachBall(pos: (-4.0, 1.5, -2.0)),

        // === SEESAW PUZZLE ===
        // Plank balanced on a crate = seesaw
        HeavyCrate(pos: (3.0, -3.5, 0.0), size: 0.5),
        Plank(pos: (3.0, -2.5, 0.0), length: 6.0, width: 1.5),

        // Crate sitting on the high end of the seesaw — grenade the low end
        // to launch this crate onto the raised ledge
        Crate(pos: (1.0, -1.5, 0.0), size: 0.5),

        // Extra crates for experimentation
        Crate(pos: (5.0, -3.5, 3.0), size: 0.4),
        Crate(pos: (5.0, -3.5, -3.0), size: 0.4),

        // === DOMINO ALLEY ===
        // Line of increasingly tall towers — topple the first into the second...
        Tower(
            base: (12.0, -3.5, 0.0),
            box_half_extents: (0.3, 0.4, 0.3),
            count: 3,
            density: 15.0,
        ),
        Tower(
            base: (14.0, -3.5, 0.0),
            box_half_extents: (0.3, 0.4, 0.3),
            count: 4,
            density: 15.0,
        ),
        Tower(
            base: (16.0, -3.5, 0.0),
            box_half_extents: (0.3, 0.4, 0.3),
            count: 5,
            density: 15.0,
        ),
        Tower(
            base: (18.0, -3.5, 0.0),
            box_half_extents: (0.3, 0.4, 0.3),
            count: 6,
            density: 15.0,
        ),
        Tower(
            base: (20.0, -3.5, 0.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 7,
            density: 18.0,
        ),

        // The last domino needs to hit this wall to clear the path
        BoxWall(
            base: (22.0, -3.5, 0.0),
            box_half_extents: (0.4, 0.5, 0.5),
            columns: 2,
            rows: 4,
            density: 20.0,
            stagger: false,
        ),

        // === BOWLING SECTION ===
        // Beach ball "bowling ball" — launch it with a grenade
        BeachBall(pos: (26.0, -3.0, 0.0)),
        BeachBall(pos: (26.0, -3.0, 2.0)),

        // Crate "pins" in a triangle formation
        Tower(
            base: (32.0, -3.5, -2.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 3,
            density: 18.0,
        ),
        Tower(
            base: (32.0, -3.5, 0.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 3,
            density: 18.0,
        ),
        Tower(
            base: (32.0, -3.5, 2.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 3,
            density: 18.0,
        ),
        Tower(
            base: (33.0, -3.5, -1.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 4,
            density: 18.0,
        ),
        Tower(
            base: (33.0, -3.5, 1.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 4,
            density: 18.0,
        ),

        // === VERTICAL CLIMB ===
        // Crates and planks — the player must stack them on pillars
        Crate(pos: (37.0, -3.5, 2.0), size: 0.6),
        Crate(pos: (38.0, -3.5, -2.0), size: 0.6),
        Crate(pos: (39.0, -3.5, 1.0), size: 0.5),
        HeavyCrate(pos: (37.0, -3.5, -1.0), size: 0.7),
        Plank(pos: (38.0, -3.5, 0.0), length: 4.0, width: 1.2),
        Plank(pos: (40.0, -3.5, -1.0), length: 3.0, width: 1.0),

        // === GOAL ISLAND ===
        House(
            pos: (40.0, 7.5, 0.0),
            half_extents: (0.5, 0.5, 0.5),
        ),
    ],

)
