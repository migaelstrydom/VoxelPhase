// Crate Canyon — Medium difficulty.
// A deep canyon carved into the terrain. The player must cross it using
// crates, planks, and creative destruction. Multiple routes reward
// exploration.
//
// Layout (side view, X is forward):
//
//   [Start]                              [End]
//    ___                                  ___
//   |   |   pillar   plank   island     |   |
//   |   |     |       ===      O        |   |
//   |   |_____|________________________ |   |
//   |            CANYON FLOOR            |   |
//   |____________________________________|   |
//
Level(
    name: "Crate Canyon",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -10.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 3.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // Starting mesa — high ground
            Plateau(min: (-15.0, -8.0), max: (-4.0, 8.0), height: 6.0),

            // Canyon floor — low, dangerous
            Plateau(min: (-4.0, -10.0), max: (20.0, 10.0), height: -4.0),

            // Ending mesa — same height as start
            Plateau(min: (20.0, -8.0), max: (30.0, 8.0), height: 6.0),

            // Narrow ledge along the canyon wall (south side)
            Wall(from: (-4.0, -7.0), to: (20.0, -7.0), height: 2.0, thickness: 1.5),

            // Ramp from canyon floor back up to the end mesa
            Ramp(from: (16.0, 4.0), to: (20.0, 4.0), start_height: -4.0, end_height: 6.0, width: 3.0),

            // Background scenery
            Hill(center: (-20.0, -15.0), radius: 8.0, height: 5.0),
            Hill(center: (30.0, 15.0), radius: 10.0, height: 4.0),

            TerrainRoughness(frequency: 0.12, amplitude: 0.3, octaves: 2, seed: 202),
        ],

        volumes: [
            // Pillar in the middle of the canyon — stepping stone
            Pillar(center: (4.0, 0.0), height: 8.0, radius: 1.8),

            // Floating island — the "shortcut" route
            Island(center: (12.0, 8.0, 0.0), half_extents: (3.0, 1.0, 3.0), edge_noise: 0.3),
        ],
    ),

    player_spawn: (-10.0, 8.0, 0.0),

    objects: [
        // === STARTING MESA ===
        // Crates to push off the edge into the canyon for makeshift steps
        Crate(pos: (-6.0, 7.0, 0.0), size: 0.6),
        Crate(pos: (-6.0, 7.0, 2.0), size: 0.6),
        Crate(pos: (-6.0, 7.0, -2.0), size: 0.6),

        // Heavy crate — won't bounce when it lands
        HeavyCrate(pos: (-7.0, 7.0, 0.0), size: 0.8),

        // Plank for bridging — push it off the edge toward the pillar
        Plank(pos: (-5.5, 7.0, 3.0), length: 5.0, width: 1.5),

        // === CANYON FLOOR ===
        // Scattered debris to climb on
        Crate(pos: (0.0, -3.5, 0.0), size: 0.5),
        Crate(pos: (2.0, -3.5, 1.0), size: 0.5),
        HeavyCrate(pos: (6.0, -3.5, -1.0), size: 0.7),

        // Beach balls rolling around the canyon floor
        BeachBall(pos: (3.0, -3.0, 2.0)),
        BeachBall(pos: (8.0, -3.0, -2.0)),
        BeachBall(pos: (14.0, -3.0, 0.0)),

        // === PILLAR TOP ===
        // A crate sitting on the pillar — push it off to create a step,
        // or use it as a platform
        Crate(pos: (4.0, 5.0, 0.0), size: 0.5),

        // === FLOATING ISLAND ===
        // Small house as a landmark
        House(
            pos: (12.0, 9.5, 0.0),
            half_extents: (0.5, 0.5, 0.5),
        ),

        // Plank bridge from island toward end mesa
        Plank(pos: (17.0, 8.5, 0.0), length: 6.0, width: 1.5),

        // === APPROACH TO END MESA ===
        // Crate wall — blast through or climb over
        BoxWall(
            base: (20.5, 6.5, 0.0),
            box_half_extents: (0.5, 0.5, 0.5),
            columns: 3,
            rows: 4,
            density: 35.0,
            stagger: true,
        ),

        // === END MESA ===
        BeachBall(pos: (25.0, 7.5, 0.0)),
    ],
)