// The Great Escape — Hard difficulty.
// You start at the bottom of a deep pit. The only way out is up —
// using grenades, stacked crates, ramps, and floating islands as
// stepping stones to reach the surface and then the mountaintop goal.
//
// Layout (side view, Y is up):
//
//   [Goal]  ~  y=20
//     |
//   [Summit Island]  ~  y=16
//     |
//   [Mid Island]  ~  y=12
//     |
//   [Ledge + Ramp]  ~  y=4
//     |
//   [PIT FLOOR]  ~  y=-6
//     |
//   [Spawn]
//
Level(
    name: "The Great Escape",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -10.0,
        material_layers: [
            (depth: 1.0,  material: Dirt),
            (depth: 3.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // Surrounding high ground — the "surface" the player is trying to reach
            Plateau(min: (-25.0, -25.0), max: (25.0, 25.0), height: 4.0),

            // The pit — a deep rectangular hole
            Crater(center: (0.0, 0.0), radius: 12.0, depth: 10.0),

            // Ledge partway up the pit wall (south side)
            Wall(from: (-8.0, -10.0), to: (8.0, -10.0), height: 0.0, thickness: 3.0),

            // Ramp from the ledge toward the surface on the south side
            Ramp(from: (6.0, -10.0), to: (12.0, -10.0), start_height: 0.0, end_height: 4.0, width: 3.0),

            // Mountaintop where the goal sits
            Hill(center: (0.0, 15.0), radius: 6.0, height: 6.0),

            // Background hills
            Hill(center: (-20.0, -20.0), radius: 8.0, height: 3.0),
            Hill(center: (20.0, 18.0), radius: 7.0, height: 4.0),

            TerrainRoughness(frequency: 0.08, amplitude: 0.3, octaves: 3, seed: 505),
        ],

        volumes: [
            // Floating island — midway escape route
            Island(center: (0.0, 9.0, 5.0), half_extents: (3.5, 1.0, 3.5), edge_noise: 0.3),

            // High island near the mountaintop
            Island(center: (-4.0, 14.0, 12.0), half_extents: (2.5, 0.8, 2.5), edge_noise: 0.4),

            // Pillar in the pit — a crucial stepping stone
            Pillar(center: (0.0, 5.0), height: 8.0, radius: 1.5),

            // Another pillar near the rim
            Pillar(center: (-6.0, -3.0), height: 6.0, radius: 1.2),
        ],
    ),

    player_spawn: (0.0, -4.0, 0.0),

    objects: [
        // === PIT FLOOR ===
        // Crates scattered on the pit floor — stack them to start climbing
        Crate(pos: (-2.0, -5.5, 0.0), size: 0.6),
        Crate(pos: (1.0, -5.5, -1.0), size: 0.6),
        Crate(pos: (-1.0, -5.5, 2.0), size: 0.6),
        Crate(pos: (2.0, -5.5, 1.0), size: 0.6),
        HeavyCrate(pos: (0.0, -5.5, -2.0), size: 0.8),
        HeavyCrate(pos: (-3.0, -5.5, -1.0), size: 0.8),

        // Planks for bridging
        Plank(pos: (3.0, -5.5, 0.0), length: 4.0, width: 1.2),
        Plank(pos: (-4.0, -5.5, 2.0), length: 3.0, width: 1.0),

        // Beach balls — grenade them for laughs, or use them as distractions
        BeachBall(pos: (0.0, -4.5, 0.0)),
        BeachBall(pos: (3.0, -4.5, 3.0)),

        // === PILLAR TOP ===
        // A crate on the pillar — use it as a step to the island
        Crate(pos: (0.0, 3.0, 5.0), size: 0.5),

        // === MID ISLAND ===
        // More supplies for the next jump
        Crate(pos: (0.0, 10.5, 5.0), size: 0.5),
        Crate(pos: (1.0, 10.5, 6.0), size: 0.5),
        Plank(pos: (-1.0, 10.5, 4.0), length: 4.0, width: 1.0),

        // === LEDGE ===
        // Stack of crates on the south ledge — alternative route up
        Stack(
            base: (0.0, 0.5, -10.0),
            items: [
                HeavyCrate(size: 0.8),
                HeavyCrate(size: 0.8),
                Crate(size: 0.6),
                Crate(size: 0.5),
            ],
        ),

        // === SURFACE ===
        // Once the player reaches the surface, these help reach the mountaintop
        Crate(pos: (2.0, 5.0, 10.0), size: 0.6),
        Crate(pos: (-2.0, 5.0, 12.0), size: 0.6),
        HeavyCrate(pos: (0.0, 5.0, 14.0), size: 0.7),

        // Beach balls on the surface
        BeachBall(pos: (5.0, 5.5, 8.0)),
        BeachBall(pos: (-3.0, 5.5, 13.0)),

        // === HIGH ISLAND ===
        // Bridge plank from the high island toward the mountaintop
        Plank(pos: (-2.0, 15.0, 13.0), length: 5.0, width: 1.2),

        // === MOUNTAINTOP ===
        // Victory house
        House(
            pos: (0.0, 12.0, 15.0),
            half_extents: (0.5, 0.5, 0.5),
        ),
    ],

)
