// Test arena — reproduces the original hardcoded scene.
Level(
    name: "Test Arena",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: 0.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 4.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],
        features: [
            TerrainRoughness(frequency: 0.1, amplitude: 3.0, octaves: 3, seed: 42),
            Crater(center: (0.0, 0.0), radius: 10.0, depth: 3.0),
        ],
    ),

    player_spawn: (0.0, 2.0, 0.0),

    objects: [
        BeachBall(pos: (3.0, 5.0, 2.0)),
        BeachBall(pos: (-2.0, 4.0, -1.0)),
        BeachBall(pos: (1.0, 6.0, 4.0)),
        BeachBall(pos: (-4.0, 3.0, -3.0)),
        BeachBall(pos: (2.0, 5.0, 0.0)),

        // Stacked boxes (was 5 boxes at x=0, z=2)
        Tower(
            base: (0.0, -1.5, 2.0),
            box_half_extents: (0.5, 0.5, 0.5),
            count: 5,
        ),

        House(
            pos: (0.0, 10.0, 5.0),
            half_extents: (0.5, 0.5, 0.5),
        ),
    ],
)
