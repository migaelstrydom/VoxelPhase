// Sky Islands — Hard difficulty.
// A series of floating islands high above a void. The player must
// jump, grenade-boost, and build makeshift bridges to hop between
// islands. One wrong step means a long fall.
//
// Layout (top-down, approximate):
//
//   [Start Island]--[Chain Islands]--[Hub Island]
//        (0,0)       (10-16, ±5)      (22, 0)
//                                       |
//                          [Pillar]--[Tower Island]--[Goal Island]
//                           (28,0)     (34, 4)        (42, 0)
//
Level(
    name: "Sky Islands",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -20.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 2.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // Thin base layer far below — gives a sense of height
            TerrainRoughness(frequency: 0.05, amplitude: 1.0, octaves: 2, seed: 301),
        ],

        volumes: [
            // === START ISLAND ===
            // Generous platform to get bearings
            Island(center: (0.0, 10.0, 0.0), half_extents: (5.0, 2.0, 5.0), edge_noise: 0.2),

            // === CHAIN ISLANDS ===
            // Small stepping-stone islands — tight jumps
            Island(center: (9.0, 10.0, -3.0), half_extents: (2.0, 1.0, 2.0), edge_noise: 0.3),
            Island(center: (13.0, 11.0, 2.0), half_extents: (1.5, 0.8, 1.5), edge_noise: 0.4),
            Island(center: (17.0, 10.5, -1.0), half_extents: (2.0, 1.0, 2.0), edge_noise: 0.3),

            // === HUB ISLAND ===
            // Central hub with supplies
            Island(center: (22.0, 10.0, 0.0), half_extents: (4.0, 1.5, 4.0), edge_noise: 0.2),

            // === PILLAR ===
            // Tall pillar between hub and tower island — can land on top
            Pillar(center: (28.0, 0.0), height: 14.0, radius: 1.5),

            // === TOWER ISLAND ===
            // High island with the crate tower challenge
            Island(center: (34.0, 14.0, 4.0), half_extents: (3.0, 1.5, 3.0), edge_noise: 0.3),

            // === GOAL ISLAND ===
            // Final destination — small and elevated
            Island(center: (42.0, 16.0, 0.0), half_extents: (3.0, 1.0, 3.0), edge_noise: 0.4),

            // === SCENIC ISLAND ===
            // Unreachable eye candy in the distance
            Island(center: (-20.0, 18.0, 15.0), half_extents: (5.0, 2.0, 4.0), edge_noise: 0.6),
        ],
    ),

    player_spawn: (0.0, 14.0, 0.0),

    objects: [
        // === START ISLAND ===
        // Supplies: planks and crates for bridging
        Plank(pos: (2.0, 13.0, 0.0), length: 5.0, width: 1.2),
        Plank(pos: (-1.0, 13.0, 2.0), length: 4.0, width: 1.0),
        Crate(pos: (0.0, 13.0, -2.0), size: 0.6),
        Crate(pos: (1.0, 13.0, -3.0), size: 0.6),

        // Beach ball — kick it off the edge for fun
        BeachBall(pos: (-2.0, 13.0, 0.0)),

        // === CHAIN ISLANDS ===
        // A crate on the smallest island — precarious
        Crate(pos: (13.0, 12.5, 2.0), size: 0.4),

        // Beach ball hazard on the third island
        BeachBall(pos: (17.0, 12.5, -1.0)),

        // === HUB ISLAND ===
        // Supply depot — the player needs these for the final stretch
        Crate(pos: (21.0, 12.0, 0.0), size: 0.6),
        Crate(pos: (22.0, 12.0, 1.0), size: 0.6),
        Crate(pos: (23.0, 12.0, -1.0), size: 0.6),
        HeavyCrate(pos: (22.0, 12.0, -2.0), size: 0.7),
        Plank(pos: (21.0, 12.0, 3.0), length: 6.0, width: 1.5),

        // Beach balls
        BeachBall(pos: (20.0, 12.5, 2.0)),
        BeachBall(pos: (24.0, 12.5, -1.0)),

        // === PILLAR TOP ===
        // A single crate balanced on top — stepping stone
        HeavyCrate(pos: (28.0, 15.0, 0.0), size: 0.5),

        // === TOWER ISLAND ===
        // Tower of crates blocking the goal-side edge
        Tower(
            base: (35.0, 16.0, 4.0),
            box_half_extents: (0.5, 0.4, 0.5),
            count: 6,
            density: 30.0,
        ),

        // A plank for bridging to the goal island
        Plank(pos: (34.0, 16.0, 2.0), length: 5.0, width: 1.2),

        // Crate wall — additional obstacle
        BoxWall(
            base: (33.0, 16.0, 5.0),
            box_half_extents: (0.4, 0.4, 0.4),
            columns: 3,
            rows: 3,
            density: 25.0,
            stagger: true,
        ),

        // === GOAL ISLAND ===
        // Victory house
        House(
            pos: (42.0, 18.0, 0.0),
            half_extents: (0.5, 0.5, 0.5),
        ),
    ],

)
