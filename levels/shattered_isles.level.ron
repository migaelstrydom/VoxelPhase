// The Shattered Isles — a sprawling adventure across broken terrain,
// floating islands, ancient ruins, and a chaotic playground.
//
// Zone layout (roughly to scale):
//
//           LOOKOUT PEAK           SKYBRIDGE CANYON
//           (-35,-35) h=12         (0,-35) d=10
//                                  floating islands
//     PLAYGROUND RIDGE                   ^
//     (-24,-18) h=3                      |         CRATER LAKE
//                              SPAWN     |         (25,-22) d=8
//                              KNOLL     |
//                              (0,0) h=4 |         TEMPLE PLATEAU
//                                        |         (40,10) h=6
//     THE GAUNTLET                       |
//     (-22,18) d=3                       v
//                                  TOWER FIELD
//                                  (10,32) h=-1
Level(
    name: "The Shattered Isles",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: 0.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 5.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],
        features: [
            // Natural ground variation
            TerrainRoughness(frequency: 0.06, amplitude: 1.5, octaves: 3, seed: 7731),

            // === SPAWN KNOLL ===
            // Gentle hillock where the player begins — good vantage point.
            Hill(center: (0.0, 0.0), radius: 12.0, height: 4.0),

            // === CRATER LAKE (northeast) ===
            // Deep impact crater filled with water. Ring of standing stones.
            Crater(center: (25.0, -22.0), radius: 16.0, depth: 8.0),

            // === TEMPLE PLATEAU (east) ===
            // Raised flat mesa for the ruined temple complex.
            Plateau(min: (30.0, 2.0), max: (52.0, 18.0), height: 6.0),
            // Ramp up to the plateau from ground level
            Ramp(from: (28.0, 10.0), to: (32.0, 10.0), start_height: 0.0, end_height: 6.0, width: 6.0),

            // === THE GAUNTLET (southwest) ===
            // Walled canyon with domino runs and obstacles.
            Crater(center: (-22.0, 18.0), radius: 10.0, depth: 3.0),
            // Ramp into the gauntlet pit
            Ramp(from: (-12.0, 18.0), to: (-15.0, 18.0), start_height: 0.0, end_height: -3.0, width: 4.0),

            // === PLAYGROUND RIDGE (northwest) ===
            // Elevated ridge with interactive toys.
            Hill(center: (-24.0, -18.0), radius: 18.0, height: 3.0),

            // === TOWER FIELD (south) ===
            // Flat area for destructible structures.
            Plateau(min: (0.0, 24.0), max: (20.0, 40.0), height: -1.0),

            // === SKYBRIDGE CANYON (north) ===
            // Deep ravine spanned by floating islands and arches.
            Crater(center: (0.0, -35.0), radius: 20.0, depth: 10.0),

            // === LOOKOUT PEAK (far northwest) ===
            // Tall hill with a view of everything.
            Hill(center: (-35.0, -35.0), radius: 8.0, height: 12.0),

            // Terrain walls forming the canyon edges
            Wall(from: (-15.0, -25.0), to: (15.0, -25.0), height: 4.0, thickness: 2.0),
            Wall(from: (-15.0, -45.0), to: (15.0, -45.0), height: 4.0, thickness: 2.0),
        ],
        volumes: [
            // === FLOATING ISLANDS over the canyon ===
            Island(center: (-8.0, 10.0, -35.0), half_extents: (4.0, 1.5, 4.0), edge_noise: 0.4),
            Island(center: (0.0, 14.0, -35.0), half_extents: (3.0, 1.0, 3.0), edge_noise: 0.5),
            Island(center: (8.0, 11.0, -35.0), half_extents: (4.0, 1.5, 3.5), edge_noise: 0.3),

            // Small stepping-stone islands
            Island(center: (-4.0, 8.0, -32.0), half_extents: (1.5, 0.8, 1.5), edge_noise: 0.6),
            Island(center: (4.0, 9.0, -38.0), half_extents: (2.0, 0.8, 2.0), edge_noise: 0.5),

            // Floating reward island above the lookout peak
            Island(center: (-35.0, 18.0, -35.0), half_extents: (3.0, 1.0, 3.0), edge_noise: 0.3),

            // Natural stone arch connecting spawn area to playground
            Arch(from: (-8.0, 3.0, -6.0), to: (-16.0, 3.0, -12.0), radius: 5.0, thickness: 2.0),

            // Grand arch over the canyon entrance
            Arch(from: (-10.0, 2.0, -25.0), to: (10.0, 2.0, -25.0), radius: 10.0, thickness: 2.5),

            // Decorative pillars along the temple approach
            Pillar(center: (28.0, 6.0), height: 8.0, radius: 1.0),
            Pillar(center: (28.0, 14.0), height: 8.0, radius: 1.0),

            // Pillar cluster near crater lake
            Pillar(center: (18.0, -15.0), height: 5.0, radius: 0.8),
            Pillar(center: (32.0, -15.0), height: 5.0, radius: 0.8),
            Pillar(center: (25.0, -12.0), height: 6.0, radius: 1.0),

            // Tunnel shortcut from tower field to spawn
            Tunnel(center: (5.0, 12.0), direction: (0.0, -1.0), length: 16.0, radius: 2.5, depth: -2.0),
        ],
    ),

    player_spawn: (0.0, 6.0, 0.0),

    water: Some(WaterConfig(
        ocean_level: None,
        bodies: [
            // Crater lake
            Pool(
                seed: (25.0, -22.0),
                surface_level: -4.0,
            ),
            // Gauntlet puddle
            Pool(
                seed: (-22.0, 18.0),
                surface_level: -2.0,
            ),
            // Canyon floor pool
            Pool(
                seed: (0.0, -35.0),
                surface_level: -6.0,
            ),
        ],
    )),

    objects: [
        // ==========================================================
        //  SPAWN KNOLL — gentle introduction (hill at origin, h=4)
        // ==========================================================
        BeachBall(pos: (2.0, 6.0, 2.0)),
        BeachBall(pos: (-1.0, 6.0, -2.0)),
        BeachBall(pos: (-3.0, 6.0, 1.0)),

        // Welcoming trampoline to launch players into the world
        Trampoline(pos: (4.0, 4.5, -2.0)),

        // A few jacks to kick around on the knoll
        Jack(pos: (1.0, 5.0, 4.0), length: 0.5, thickness: 0.1),
        Jack(pos: (-2.0, 5.0, 4.0), length: 0.5, thickness: 0.1),
        Jack(pos: (3.0, 5.0, 1.0), length: 0.5, thickness: 0.1),

        // ==========================================================
        //  CRATER LAKE — stone circle + concrete breakwater armour
        //  (crater (25,-22), r=16, d=8; water surface y=-4, floor ~y=-8)
        // ==========================================================
        // Ring of menhirs around the crater (anchored — snaps to surface)
        Menhir(pos: (25.0, -12.0), half_height: 3.0, bottom_radius: 1.0, top_radius: 0.6),
        Menhir(pos: (18.0, -18.0), half_height: 2.5, bottom_radius: 0.9, top_radius: 0.5),
        Menhir(pos: (32.0, -18.0), half_height: 2.5, bottom_radius: 0.9, top_radius: 0.5),
        Menhir(pos: (18.0, -26.0), half_height: 2.0, bottom_radius: 0.8, top_radius: 0.5),
        Menhir(pos: (32.0, -26.0), half_height: 2.0, bottom_radius: 0.8, top_radius: 0.5),
        Menhir(pos: (25.0, -32.0), half_height: 3.0, bottom_radius: 1.0, top_radius: 0.6),

        // Trilithon gateway on the crater approach
        Trilithon(pos: (20.0, 0.0, -14.0)),

        // Dolos breakwater — heavy concrete armour on the crater slope.
        // Crater formula: y = -d*(1+cos(πt))/2 with d=8, r=16. Positions
        // chosen so each dolos rests in the shallow dry lip just above
        // water surface y=-4.
        // At dist 7 from (25,-22), floor y ≈ -4.78.
        // At dist 9 from (25,-22), floor y ≈ -3.30.
        Dolos(pos: (18.0, -4.2, -22.0)),                 // dist 7 W
        Dolos(pos: (32.0, -4.2, -22.0)),                 // dist 7 E
        Dolos(pos: (25.0, -4.2, -29.0)),                 // dist 7 S
        Dolos(pos: (19.0, -2.9, -14.0), shank_length: 1.8, fluke_length: 1.3, thickness: 0.55),  // NW
        Dolos(pos: (31.0, -2.9, -14.0), shank_length: 1.8, fluke_length: 1.3, thickness: 0.55),  // NE

        // Platonic-solid relics at the gateway (base terrain ~y=0 ± roughness).
        Dodecahedron(pos: (22.0, 0.7, -14.0), size: 0.6),
        Icosahedron(pos: (28.0, 0.6, -14.0), size: 0.8),
        Octahedron(pos: (25.0, 0.3, -11.0), size: 0.7),

        // ==========================================================
        //  TEMPLE PLATEAU — ancient ruins (plateau top y=6, x 30-52, z 2-18)
        //
        //  Temple is sized to fit the plateau: column_height=5 gives
        //  spacing=1.91, half_w=2.86, half_l=3.82. Footprint x 37.14-42.86,
        //  z 6.18-13.82. Arch sits in front of temple (z 2.75-5.25), trilithon
        //  pair sits behind (z ~15.6-16.4), Jenga + pyramid fill the east side.
        // ==========================================================
        Temple(
            pos: (40.0, 6.0, 10.0),
            column_height: 5.0,
            front_columns: 4,
            side_columns: 5,
        ),

        // Grand voussoir entrance arch — centered in front of temple
        // (x 34-46, z 2.75-5.25, plateau edges x 30/52, z 2/18)
        VoussoirArch(
            base: (40.0, 6.0, 4.0),
            inner_radius: 4.0,
            thickness: 2.0,
            depth: 2.5,
            num_voussoirs: 11,
            abutment_height: 1.0,
            friction: 0.9,
        ),

        // Trilithon pair behind the temple (z 15.6-16.4)
        Trilithon(pos: (38.0, 6.0, 16.0)),
        Trilithon(pos: (42.0, 6.0, 16.0)),

        // Jenga tower in back-right corner (1.5 x 1.5 footprint)
        Jenga(base: (50.0, 6.0, 14.0), layers: 6),

        // Stepped pyramid beside Jenga (2.4 x 2.4 footprint)
        Pyramid(
            base: (46.0, 6.0, 14.0),
            block_half_extents: (0.4, 0.25, 0.4),
            base_width: 3,
        ),

        // Offerings on the plateau beside the arch (west and east flanks).
        // Heights set to inradius/half-height on plateau y=6 so they start
        // touching the surface when asleep.
        Tetrahedron(pos: (33.0, 6.16, 10.0), size: 0.8),
        HexPrism(pos: (47.0, 6.4, 10.0), radius: 0.3, half_height: 0.4),
        // Two jacks flanking the temple entrance
        Jack(pos: (36.0, 6.3, 5.0), length: 0.6, thickness: 0.12),
        Jack(pos: (44.0, 6.3, 5.0), length: 0.6, thickness: 0.12),

        // ==========================================================
        //  THE GAUNTLET — obstacle course in a crater (floor ~y=-3)
        //  (crater (-22,18), r=10, d=3)
        // ==========================================================
        // Domino spiral feeding into the gauntlet
        Domino(
            base: (-16.0, -3.0, 14.0),
            direction: (0.0, 1.0),
            count: 14,
            spacing: 0.45,
        ),
        Domino(
            base: (-16.0, -3.0, 20.0),
            direction: (-1.0, 0.0),
            count: 10,
            spacing: 0.45,
        ),
        Domino(
            base: (-26.0, -3.0, 20.0),
            direction: (0.0, -1.0),
            count: 8,
            spacing: 0.45,
        ),

        // Honeycomb wall to smash through mid-gauntlet
        HoneycombWall(
            base: (-22.0, -3.0, 16.0),
            columns: 6,
            rows: 5,
            radius: 0.35,
            half_height: 0.2,
        ),

        // Staggered box wall barricade
        BoxWall(
            base: (-20.0, -3.0, 22.0),
            box_half_extents: (0.4, 0.4, 0.4),
            columns: 6,
            rows: 4,
            stagger: true,
        ),

        // Heavy crate — useful as a stepping block
        HeavyCrate(pos: (-18.0, -1.0, 18.0), size: 0.8),

        // Plank bridge across the deepest part of the crater
        PlankBridge(
            pos: (-22.0, -2.0, 18.0),
            length: 6.0,
            yaw: 1.57,
        ),

        // Dolos guarding the gauntlet rim — heavy to shove aside
        Dolos(pos: (-22.0, 1.0, 10.0)),

        // ==========================================================
        //  PLAYGROUND RIDGE — interactive toys (hill (-24,-18), h=3)
        // ==========================================================
        // All anchored toys auto-snap to terrain surface
        Seesaw(
            pos: (-20.0, -14.0),
            beam_half_length: 5.0,
            beam_half_width: 0.5,
            beam_half_thickness: 0.12,
            fulcrum_height: 0.6,
        ),

        PlayWheel(
            pos: (-26.0, -18.0),
            radius: 2.5,
            hub_height: 0.5,
        ),

        Pendulum(pos: (-20.0, -22.0)),

        // Trampoline chain above the ridge — bounce between them
        Trampoline(pos: (-28.0, 4.5, -16.0)),
        Trampoline(pos: (-24.0, 5.0, -16.0)),
        Trampoline(pos: (-20.0, 4.5, -16.0)),

        // Fence-post slalom (all terrain-anchored)
        FencePost(pos: (-22.0, -12.0), half_height: 1.2, radius: 0.2),
        FencePost(pos: (-24.0, -13.0), half_height: 1.2, radius: 0.2),
        FencePost(pos: (-26.0, -12.0), half_height: 1.2, radius: 0.2),
        FencePost(pos: (-28.0, -13.0), half_height: 1.2, radius: 0.2),

        // Beach balls for seesaw / playwheel play
        BeachBall(pos: (-22.0, 5.0, -18.0)),
        BeachBall(pos: (-25.0, 5.0, -20.0)),
        BeachBall(pos: (-19.0, 5.0, -17.0)),

        // Table with a small stack on top
        Table(pos: (-30.0, 4.0, -20.0)),
        Stack(
            base: (-30.0, 5.2, -20.0),
            items: [
                Crate(size: 0.3),
                BeachBall,
            ],
        ),

        // Small jacks scattered on the ridge — trip hazard
        Jack(pos: (-23.0, 4.0, -15.0), length: 0.4, thickness: 0.08),
        Jack(pos: (-27.0, 4.0, -19.0), length: 0.4, thickness: 0.08),

        // ==========================================================
        //  TOWER FIELD — destructible playground (plateau y=-1)
        // ==========================================================
        // Tall tower — the main target
        Tower(
            base: (5.0, -1.0, 28.0),
            box_half_extents: (0.5, 0.5, 0.5),
            count: 8,
        ),

        // Crate pyramid beside it
        Pyramid(
            base: (10.0, -1.0, 32.0),
            block_half_extents: (0.5, 0.3, 0.5),
            base_width: 3,
        ),

        // Staggered wall to charge through
        BoxWall(
            base: (14.0, -1.0, 28.0),
            box_half_extents: (0.5, 0.5, 0.5),
            columns: 8,
            rows: 5,
            stagger: true,
        ),

        // Long domino chain across the field
        Domino(
            base: (2.0, -1.0, 36.0),
            direction: (1.0, 0.0),
            count: 20,
            spacing: 0.4,
        ),

        // Scattered projectiles. Plateau y=-1; pos.y = -1 + half_extent so
        // each sits flush on the surface.
        Crate(pos: (8.0, -0.5, 30.0), size: 0.5),
        Crate(pos: (12.0, -0.5, 30.0), size: 0.5),
        Box(pos: (6.0, -0.4, 34.0), half_extents: (0.6, 0.6, 0.6), style: Gift),
        Box(pos: (16.0, -0.5, 34.0), half_extents: (0.5, 0.5, 0.5), style: WoodenCrate),
        Tetrahedron(pos: (4.0, -0.75, 32.0), size: 1.2),
        Octahedron(pos: (18.0, -0.6, 32.0), size: 1.0),

        // House at the back of the field — final target
        House(pos: (10.0, -1.0, 38.0), half_extents: (1.5, 1.2, 1.5)),

        // Bowling alley: heavy crate as the ball, dolos as the pins
        HeavyCrate(pos: (1.0, -0.3, 38.0), size: 0.7),
        Dolos(pos: (6.0, -0.8, 38.0)),
        Dolos(pos: (8.0, -0.8, 38.0)),
        Dolos(pos: (10.0, -0.8, 38.0)),

        // ==========================================================
        //  SKYBRIDGE CANYON — floating-island platforming
        //  Island tops: west y≈11.5, central y≈15, east y≈12.5.
        //  Canyon formula depth = -d*(1+cos(πt))/2 with d=10, r=20: at dist 3
        //  floor is ~y=-9.45; pool surface at y=-6.
        // ==========================================================
        // Western island (top y≈11.5) — capsule lying on its side, beachball
        Capsule(pos: (-8.0, 11.8, -35.0), half_height: 1.0, radius: 0.3),
        BeachBall(pos: (-7.0, 12.0, -34.0)),

        // Central island (top y≈15) — reward for the hardest jump
        Tetrahedron(pos: (0.0, 15.25, -35.0), size: 1.2),
        Jack(pos: (0.5, 15.3, -33.5), length: 0.5, thickness: 0.1),

        // Eastern island (top y≈12.5) — tiny Jenga to topple
        Jenga(base: (8.0, 12.5, -35.0), layers: 5),

        // Canyon floor — wrecked dolos breakwater (floor ~y=-9.45, pool y=-6)
        Dolos(pos: (-3.0, -9.0, -35.0), shank_length: 1.8, fluke_length: 1.3, thickness: 0.5),
        Dolos(pos: (3.0, -9.0, -35.0), shank_length: 1.8, fluke_length: 1.3, thickness: 0.5),
        Dolos(pos: (0.0, -9.0, -38.0), shank_length: 1.8, fluke_length: 1.3, thickness: 0.5),

        // ==========================================================
        //  LOOKOUT PEAK — the summit (hill (-35,-35), h=12)
        // ==========================================================
        // Solitary menhir at the peak — landmark visible from everywhere
        Menhir(pos: (-35.0, -35.0), half_height: 4.0, bottom_radius: 1.2, top_radius: 0.7),

        // Pendulum relocated to the slope below so it doesn't clip the menhir
        Pendulum(pos: (-30.0, -32.0)),

        // Reward cairn on the floating island above the peak.
        // Island center (-35, 18, -35) half_extents (3, 1, 3), top at y=19.
        Stack(
            base: (-35.0, 19.0, -35.0),
            items: [
                HeavyCrate(size: 0.6),
                Crate(size: 0.5),
                Crate(size: 0.4),
                BeachBall,
            ],
        ),

        // A pair of jacks beside the menhir at the summit.
        // Peak hill h=12 at (-35,-35); dist 1 from center → surface y≈11.54.
        Jack(pos: (-34.0, 11.9, -35.0), length: 0.5, thickness: 0.1),
        Jack(pos: (-36.0, 11.9, -35.0), length: 0.5, thickness: 0.1),

        // ==========================================================
        //  CONNECTING ELEMENTS
        // ==========================================================
        // Plank bridge hanging beneath the natural arch near spawn
        PlankBridge(
            pos: (-12.0, 2.0, -9.0),
            length: 8.0,
            yaw: 0.7,
        ),

        // Capsule logs along the main paths
        Capsule(pos: (10.0, 1.0, 5.0), half_height: 2.0, radius: 0.3, density: 600.0),
        Capsule(pos: (15.0, 1.0, -5.0), half_height: 2.5, radius: 0.35, density: 600.0),

        // Hex prisms along the temple-ramp approach
        HexPrism(pos: (30.0, 4.0, 8.0), radius: 0.5, half_height: 0.8),
        HexPrism(pos: (30.0, 3.0, 12.0), radius: 0.5, half_height: 0.8),

        // Wandering beach balls dotting the world
        BeachBall(pos: (15.0, 3.0, 0.0)),
        BeachBall(pos: (-5.0, 2.0, 10.0)),
        BeachBall(pos: (8.0, 2.0, -15.0)),
    ],
)
