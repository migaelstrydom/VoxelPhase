// Bestiary: the bell carrier, alone on a lawn, for looking at it and for meeting
// it on open ground. Each creature has a level of its own in this folder,
// on the same lawn.
//
// It stands in the middle and the player starts 14 m south of it, facing
// it. It is awake.
Level(
    name: "Bestiary: Bell carrier",

    segments: [
        (
            name: "lawn",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (-32.0, -16.0, -32.0), max: (32.0, 16.0, 32.0)),
                base_height: 0.0,
                material_layers: [
                    (depth: 0.6,   material: Grass),
                    (depth: 2.5,   material: Dirt),
                    (depth: 999.0, material: Limestone),
                ],
                features: [
                    // A low swell, so the lawn is not a table.
                    TerrainRoughness(frequency: 0.05, amplitude: 0.5, octaves: 2, seed: 3),
                ],
            ),

            objects: [
                BellCarrier(pos: (0.0, 0.0)),
            ],
        ),
    ],

    placements: [Root(segment: "lawn")],

    player_spawn: (0.0, 2.0, 14.0),

    meadow: Some(()),

    daylight: (
        sun_bearing: 125.0,
        sun_elevation: 26.0,
        sun_colour: (1.0, 0.78, 0.52),
        sun_intensity: 2.0,
        fill_colour: (0.06, 0.06, 0.08),
        visibility: Some(160.0),
    ),
)
