// Traversal Garden: one station per lane for the character_viewer's traversal
// scenarios (`src/character_viewer/traversal_scenarios.rs`).
//
// Every lane runs along +x. A scenario starts at x = -5 on flat ground, has
// 12 m to come up to speed, meets its station at x = 7 (the bridges start at
// x = 3) and runs out east of it to x = 35. Lanes, by z:
//
//   z -12 -8 -4 0 4     lips of 3, 8, 15, 25 and 40 cm, faces at x = 7
//   z  10               the Test Arena's plank bridge, plank for plank
//   z  18               a plank bridge with wider gaps (7 planks)
//   z  26               rough field: craggy rocks standing 8-30 cm proud
//   z  34               40 degree slope up to a shelf 6.7 m high
//   z  42               50 degree slope up to a shelf 7.2 m high
//   z  50               35 degree scree: the slope strewn with rocks
//   z  58               a 0.7 m ledge: a wall with a top to mantle onto
//   z  66               a cave lip: a roof 0.9 m up between two walls
//
// A plank bridge lays its planks out from a hash of its position, so the one
// at z = 10 stands where the Test Arena's does, (8, 0, 10), turned to run
// along x: its gaps are that bridge's, 0.22 to 0.69 m. The wide one's run
// 0.35 to 0.88 m. Both lie on the ground between two decks level with their
// planks (0.56 m), so the lane is flush from deck to bridge to deck.
//
// Fine voxels, so a 3 cm lip is a lip and not a ramp. The player's capsule is
// 1 m tall and 0.5 m across.
Level(
    name: "Traversal Garden",

    segments: [
        (
            name: "garden",

            terrain: Terrain(
                voxel_size: 0.25,
                bounds: (min: (-16.0, -8.0, -16.0), max: (40.0, 16.0, 72.0)),
                base_height: 0.0,
                material_layers: [
                    (depth: 1.0,  material: Grass),
                    (depth: 4.0,  material: Dirt),
                    (depth: 999.0, material: Rock),
                ],
                features: [
                    // Slopes, each with a shelf at its top to run out onto.
                    Ramp(from: (7.0, 34.0), to: (15.0, 34.0), start_height: 0.0, end_height: 6.71, width: 5.0, flat_width: 4.0),
                    Plateau(min: (15.0, 31.5), max: (35.0, 36.5), height: 6.71),
                    Ramp(from: (7.0, 42.0), to: (13.0, 42.0), start_height: 0.0, end_height: 7.15, width: 5.0, flat_width: 4.0),
                    Plateau(min: (13.0, 39.5), max: (35.0, 44.5), height: 7.15),
                    Ramp(from: (7.0, 50.0), to: (15.0, 50.0), start_height: 0.0, end_height: 5.60, width: 5.0, flat_width: 4.0),
                    Plateau(min: (15.0, 47.5), max: (35.0, 52.5), height: 5.60),
                ],
                volumes: [
                    // Lips: decks rising from x = 7.
                    Platform(center: (21.0, 0.03, -12.0), half_extents: (14.0, 1.5), thickness: 1.0),
                    Platform(center: (21.0, 0.08, -8.0), half_extents: (14.0, 1.5), thickness: 1.0),
                    Platform(center: (21.0, 0.15, -4.0), half_extents: (14.0, 1.5), thickness: 1.0),
                    Platform(center: (21.0, 0.25, 0.0), half_extents: (14.0, 1.5), thickness: 1.0),
                    Platform(center: (21.0, 0.40, 4.0), half_extents: (14.0, 1.5), thickness: 1.0),

                    // Decks either side of the bridges, level with the planks.
                    Platform(center: (-3.025, 0.56, 10.0), half_extents: (5.975, 2.0), thickness: 1.0),
                    Platform(center: (24.025, 0.56, 10.0), half_extents: (10.975, 2.0), thickness: 1.0),
                    Platform(center: (-3.025, 0.56, 18.0), half_extents: (5.975, 2.0), thickness: 1.0),
                    Platform(center: (24.025, 0.56, 18.0), half_extents: (10.975, 2.0), thickness: 1.0),

