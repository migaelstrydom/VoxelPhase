                ],
                volumes: [
                    Platform(center: (-1.0, 1.0, 48.0), half_extents: (8.0, 2.0), thickness: 2.0),
                ],
            ),

            objects: [],
        ),
    ],

    placements: [
        Root(segment: "contract"),
    ],

    player_spawn: (-5.0, 1.0, 40.0),
)
