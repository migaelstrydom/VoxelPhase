// Demolition Derby — Medium difficulty.
// A flat arena packed with destructible structures. The goal is buried
// behind layers of crate walls, towers, and a house. Pure chaos —
// grenade everything and find a path through the rubble.
//
// Layout (top-down):
//
//   [Spawn]  [Outer Wall]  [Tower Ring]  [Inner Wall]  [House + Goal]
//    (-15,0)   (-8, z)     (0, various)    (8, z)       (15, 0)
//
Level(
    name: "Demolition Derby",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -2.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 3.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // Roughness first — the Plateau overwrites it inside the arena,
            // so bumps are only visible in the surrounding landscape.
            TerrainRoughness(frequency: 0.1, amplitude: 0.15, octaves: 2, seed: 404),

            // Flat arena floor
            Plateau(min: (-20.0, -18.0), max: (22.0, 18.0), height: 0.0),

            // Raised rim around the arena — keeps debris contained
            Wall(from: (-20.0, -18.0), to: (22.0, -18.0), height: 3.0, thickness: 2.0),
            Wall(from: (-20.0, 18.0), to: (22.0, 18.0), height: 3.0, thickness: 2.0),
            Wall(from: (-20.0, -18.0), to: (-20.0, 18.0), height: 3.0, thickness: 2.0),
            Wall(from: (22.0, -18.0), to: (22.0, 18.0), height: 3.0, thickness: 2.0),

            // Crater in the middle — evidence of previous demolition
            Crater(center: (0.0, 0.0), radius: 10.0, depth: 5.0),
        ],

        volumes: [
            // Pillars as arena landmarks
            Pillar(center: (-10.0, -10.0), height: 5.0, radius: 1.2),
            Pillar(center: (-10.0, 10.0), height: 5.0, radius: 1.2),
            Pillar(center: (10.0, -10.0), height: 5.0, radius: 1.2),
            Pillar(center: (10.0, 10.0), height: 5.0, radius: 1.2),
        ],
    ),

    player_spawn: (-16.0, 2.0, 0.0),

    // water: Some(WaterConfig(
    //     ocean_level: None,
    //     bodies: [
    //         Pool(
    //             seed: (0.0, .0),
    //             surface_level: -1.5,
    //         ),
    //     ],
    // )),

    objects: [
        // === OUTER CRATE WALL ===
        // First line of defense — a wide wall of lightweight crates
        BoxWall(
            base: (-8.0, -0.5, -5.0),
            box_half_extents: (0.5, 0.5, 0.5),
            columns: 5,
            rows: 4,
            density: 200.0,
            stagger: true,
        ),
        BoxWall(
            base: (-8.0, -0.5, 3.0),
            box_half_extents: (0.5, 0.5, 0.5),
            columns: 5,
            rows: 4,
            density: 200.0,
            stagger: true,
        ),

        // === TOWER RING ===
        // Towers surrounding the center — satisfying to topple
        Tower(
            base: (-2.0, -0.5, -8.0),
            box_half_extents: (0.5, 0.4, 0.5),
            count: 7,
            density: 250.0,
        ),
        Tower(
            base: (-2.0, -0.5, 8.0),
            box_half_extents: (0.5, 0.4, 0.5),
            count: 7,
            density: 250.0,
        ),
        Tower(
            base: (2.0, -0.5, -6.0),
            box_half_extents: (0.6, 0.3, 0.6),
            count: 8,
            density: 200.0,
        ),
        Tower(
            base: (2.0, -0.5, 6.0),
            box_half_extents: (0.6, 0.3, 0.6),
            count: 8,
            density: 200.0,
        ),

        // Center tower — the big one
        Tower(
            base: (0.0, -0.5, 0.0),
            box_half_extents: (0.7, 0.5, 0.7),
            count: 10,
            density: 300.0,
        ),

        // === INNER CRATE WALL ===
        // Heavier, harder to break through
        BoxWall(
            base: (8.0, -0.5, -4.0),
            box_half_extents: (0.6, 0.6, 0.6),
            columns: 4,
            rows: 5,
            density: 450.0,
            stagger: true,
        ),
        BoxWall(
            base: (8.0, -0.5, 4.0),
            box_half_extents: (0.6, 0.6, 0.6),
            columns: 4,
            rows: 5,
            density: 450.0,
            stagger: true,
        ),

        // === BEACH BALLS ===
        // Scattered around for chaos — grenades launch them into structures
        BeachBall(pos: (-12.0, 0.0, -3.0)),
        BeachBall(pos: (-12.0, 0.0, 3.0)),
        BeachBall(pos: (-12.0, 0.0, 0.0)),
        BeachBall(pos: (-5.0, 0.0, 0.0)),
        BeachBall(pos: (5.0, 0.0, -3.0)),
        BeachBall(pos: (5.0, 0.0, 3.0)),

        // === CAPSULES ===
        Capsule(pos: (-14.0, 0.0, -3.0), half_height: 1.0, radius: 0.5),
        Capsule(pos: (-14.0, 0.0, 3.0), half_height: 1.0, radius: 0.5),
        Capsule(pos: (-14.0, 0.0, 0.0), half_height: 1.0, radius: 0.5),
        Capsule(pos: (-7.0, 0.0, 0.0), half_height: 1.0, radius: 0.5),
        Capsule(pos: (3.0, 0.0, -3.0), half_height: 1.0, radius: 0.5),
        Capsule(pos: (3.0, 0.0, 3.0), half_height: 1.0, radius: 0.5),

        // === LOOSE CRATES ===
        // Extra ammunition for physics mayhem
        Crate(pos: (-14.0, 0.0, -5.0), size: 0.5),
        Crate(pos: (-14.0, 0.0, 5.0), size: 0.5),
        Crate(pos: (-14.0, 0.1, -8.0), size: 0.6),
        Crate(pos: (-14.0, 0.1, 8.0), size: 0.6),

        // === THE PRIZE ===
        // House at the far end, surrounded by heavy crates
        House(
            pos: (16.0, 1.5, 0.0),
            half_extents: (1.0, 1.0, 1.0),
        ),
        Crate(pos: (14.0, 0.3, -2.0), size: 0.8),
        Crate(pos: (14.0, 0.3, 2.0), size: 0.8),
        Crate(pos: (18.0, 0.3, 0.0), size: 0.8),
    ],

)
