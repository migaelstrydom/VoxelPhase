// Island Sea — the water demo: a pool on a floating island, over the sea.
//
// The sea opens on every edge at 0 m and floods everything below it that
// the edges reach. A low island stands out of it, with a crater lake in its
// middle. Over the water to the north a rock floats, with a pool in its top;
// a spring in the island's east cliff falls into the sea.
//
//   floating rock + pool (y 10–14) ── over the open sea to the north
//   island (2 m) ── crater lake ── east cliff spring ─▶ the sea
//
// Things to try: blow the floating pool's floor out and watch it pour into
// the sea; blow a channel from the crater lake to the shore; blow the cliff
// round the spring.
Level(
    name: "Island Sea",

    segments: [
        (
            name: "sea",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (-48.0, -16.0, -48.0), max: (48.0, 24.0, 48.0)),
                base_height: -6.0,
                material_layers: [
                    (depth: 1.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [
                    // The island: 2 m out of the sea.
                    Plateau(min: (-18.0, -6.0), max: (18.0, 26.0), height: 2.0),
                    // Its crater lake, 3 m deep at the middle.
                    Crater(center: (-4.0, 12.0), radius: 7.0, depth: 4.0),
                ],

                volumes: [
                    // The floating rock, and the trough cut in its top.
                    Island(center: (0.0, 10.0, -26.0), half_extents: (8.0, 2.0, 8.0), edge_noise: 0.0),
                    Tunnel(center: (0.0, -26.0), direction: (1.0, 0.0), length: 6.0, radius: 2.5, depth: 13.0),
                ],
            ),
        ),
    ],

    placements: [Root(segment: "sea")],

    player_spawn: (8.0, 4.0, 18.0),

    water: Some((
        ocean: Some((level: 0.0)),
        bodies: [
            Pool(seed: (-4.0, 12.0), surface_level: 1.0),
            Pool(seed: (0.0, -26.0), surface_level: 11.5),
            Spring(position: (18.2, 1.2, 8.0), direction: (1.2, 0.0, 0.0), discharge: 0.4),
        ],
    )),
)
