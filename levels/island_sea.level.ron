// Island Sea — the water demo: an island in the open ocean.
//
// A low island of beaches and grass, with a rocky massif along its north
// side that falls sheer into the sea. A crag stands on the massif's high
// north side; a spring in its face fills a tarn. The tarn spills over the
// high side's cliff, runs across the massif in a gully and goes over the
// cliff of a notch in its east side into a lake. The lake drains south as a
// river across the lowland to a sandy bay. On the north coast a second
// spring falls from the cliff straight into the sea. Sea stacks stand off a
// sandbar to the west. Foothills on the south-west are the way up.
//
//                          north (−z)
//                  ░░░░ sea cliff ░░░░ ▼ spring
//    stacks      ▓▓ crag ▶ tarn ▓▓▓▓▓▓▓
//      ▮  ▮      ▓▓▓▓▓▓▓▓▓▓ falls ▼▓▓▓▓▓▓▓
//   ▮ ═══ sandbar  ▒ foothills ▒  gully ─▶ falls ▼ ▓▓
//                  ▒▒▒▒▒▒▒▒▒▒▒▒▒       lake    ▓▓
//                lowland                 │ river
//                     ~~ bay ~~ ◀────────╯
//                     spawn on the beach
//
// Things to try: blow the tarn's lip and send it all over the falls; blow
// the lake's south shore and give the river a new course; blow the sea cliff
// under the north spring; float the crate on the lake down the river.
Level(
    name: "Island Sea",

    segments: [
        (
            name: "sea",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (-56.0, -16.0, -56.0), max: (56.0, 30.0, 56.0)),
                base_height: -8.0,
                material_layers: [
                    (depth: 0.6,   material: Grass),
                    (depth: 2.5,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],
                // Slopes and cliffs mesh smooth, not in half-voxel steps.
                smooth_slopes: true,
                surface_bands: [
                    // Cliffs are bare rock.
                    (steeper_than: Some(1.5), layers: [(depth: 999.0, material: Rock)]),
                    // Beaches, river beds and the sea floor are sand.
                    (below: Some(2.6), layers: [
                        (depth: 1.5,   material: Sand),
                        (depth: 999.0, material: Rock),
                    ]),
                ],

                features: [
                    // The sea floor's swells and gullies.
                    TerrainRoughness(frequency: 0.04, amplitude: 1.5, octaves: 3, seed: 7),

                    // The lowland: beaches rising to grass at 4 m, round a
                    // bay on the south side.
                    Landmass(
                        outline: [
                            (-34.0, 4.0), (-30.0, -8.0), (-22.0, -20.0), (-8.0, -27.0),
                            (8.0, -27.0), (24.0, -20.0), (34.0, -8.0), (40.0, 6.0),
                            (36.0, 20.0), (20.0, 30.0), (13.0, 28.0), (8.0, 22.0),
                            (0.0, 21.0), (-5.0, 26.0), (-14.0, 31.0), (-26.0, 24.0),
                            (-33.0, 15.0),
                        ],
                        shore_height: -1.5, height: 4.0, rise: 10.0, skirt: 10.0,
                        warp: 3.0, relief: 1.2, seed: 1,
                    ),
                    // The west point, a sandbar out towards the stacks.
                    Landmass(
                        outline: [(-30.0, -2.0), (-38.0, -7.0), (-45.0, -7.0), (-46.0, -3.0), (-38.0, 2.0), (-32.0, 6.0)],
                        shore_height: -1.0, height: 2.0, rise: 6.0, skirt: 8.0,
                        warp: 1.5, relief: 0.4, seed: 2,
                    ),
                    // Sea stacks off the point.
                    Landmass(
                        outline: [(-49.0, -16.0), (-46.0, -17.5), (-44.0, -14.0), (-46.0, -11.0), (-49.0, -12.0)],
                        shore_height: -6.0, height: 9.0, rise: 1.5, skirt: 1.5,
                        warp: 1.0, relief: 1.0, seed: 31,
                    ),
                    Landmass(
                        outline: [(-43.5, -22.0), (-40.0, -22.5), (-38.5, -19.0), (-41.0, -17.0), (-43.5, -18.5)],
                        shore_height: -6.0, height: 6.0, rise: 1.2, skirt: 1.5,
                        warp: 0.8, relief: 0.8, seed: 32,
                    ),
                    Landmass(
                        outline: [(-54.0, -4.5), (-50.0, -5.0), (-48.5, -1.0), (-51.0, 1.5), (-54.0, 0.5)],
                        shore_height: -6.0, height: 7.0, rise: 1.2, skirt: 1.5,
                        warp: 0.8, relief: 0.8, seed: 33,
                    ),
                    // The massif: sheer out of the sea on the north and east,
                    // and round a notch on the east that holds the lake under
                    // the falls.
                    Landmass(
                        outline: [
                            (-24.0, -8.0), (-22.0, -17.0), (-14.0, -26.0), (0.0, -29.0),
                            (14.0, -28.0), (26.0, -23.0), (35.0, -14.0), (40.0, -2.0),
                            (39.0, 9.0), (33.0, 10.0), (29.5, 7.0), (28.5, -3.0),
                            (24.5, -7.5), (20.5, -5.5), (19.5, 2.0), (10.0, 4.0),
                            (-4.0, 2.0), (-16.0, -2.0),
                        ],
                        shore_height: -2.0, height: 11.5, rise: 4.0, skirt: 2.0,
                        warp: 2.5, relief: 2.5, seed: 3,
                    ),
                    // Its high north side, a cliff above the rest.
                    Landmass(
                        outline: [
                            (-22.0, -17.0), (-14.0, -27.0), (0.0, -30.0), (14.0, -29.0),
                            (25.0, -23.0), (26.0, -17.0), (14.0, -13.0), (4.0, -9.0),
                            (-8.0, -9.0), (-18.0, -11.0),
                        ],
                        shore_height: -2.0, height: 16.0, rise: 4.5, skirt: 2.0,
                        warp: 2.5, relief: 2.5, seed: 6,
                    ),
                    // The foothills: a long grassy slope up the massif's south
                    // and west sides, the way up from the lowland.
                    Landmass(
                        outline: [
                            (-30.0, 8.0), (-31.0, -10.0), (-20.0, -16.0), (-4.0, -14.0),
                            (10.0, -9.0), (12.0, 4.0), (0.0, 12.0), (-14.0, 16.0),
                            (-26.0, 14.0),
                        ],
                        shore_height: 4.0, height: 11.5, rise: 14.0, skirt: 8.0,
                        warp: 4.0, relief: 0.8, seed: 4,
                    ),
                    // The crag on the high side.
                    Landmass(
                        outline: [
                            (-15.0, -20.0), (-12.0, -25.0), (-7.0, -26.0), (-3.5, -22.0),
                            (-4.0, -16.0), (-7.0, -13.0), (-12.0, -13.5), (-15.0, -16.0),
                        ],
                        shore_height: 16.0, height: 23.5, rise: 6.0, skirt: 0.0,
                        warp: 3.5, relief: 3.0, seed: 5,
                    ),

                    // The tarn on the high side, held at 13.3 m by its lip on
                    // the south-east.
                    Basin(center: (2.5, -19.5), radius: 5.5, floor: 11.5, warp: 3.0, seed: 11),
                    // The lake under the falls, in the massif's notch.
                    Basin(center: (24.0, 1.0), radius: 6.5, floor: 0.6, warp: 3.5, seed: 13),

                    // The stream: out of the tarn, over the high side's cliff,
                    // across the massif in a gully, and over the notch's cliff
                    // into the lake.
                    Channel(
                        points: [
                            (2.5, 13.3, -19.5), (7.5, 13.3, -15.5), (8.1, 9.6, -15.0),
                            (12.0, 9.6, -11.5), (15.0, 9.4, -8.0), (16.6, 9.4, -6.5),
                            (17.2, 1.8, -6.0), (21.5, 1.8, -2.5),
                        ],
                        width: 2.0, bank: 1.5, warp: 0.5, seed: 21,
                    ),
                    // The river: out of the lake's south end, down to the bay.
                    Channel(
                        points: [
                            (24.0, 2.6, 5.0), (24.5, 2.4, 10.0), (21.0, 2.0, 15.0),
                            (15.0, 1.4, 15.5), (10.5, 0.8, 18.5), (8.0, -1.5, 25.0),
                        ],
                        width: 1.5, bank: 2.0, warp: 1.0, seed: 22,
                    ),
                ],

            ),

            objects: [
                // Flotsam on the lake and its shore, for the river.
                Dropped(Crate(pos: (21.0, 6.0, 7.0), size: 0.4)),
                Dropped(BeachBall(pos: (27.0, 6.0, 6.0))),
                Dropped(Crate(pos: (24.0, 6.0, -1.0), size: 0.5)),
                Dropped(BeachBall(pos: (22.5, 6.0, 1.5))),
            ],
        ),
    ],

    placements: [Root(segment: "sea")],

    player_spawn: (-2.0, 6.0, 16.0),

    water: Some((
        ocean: Some((level: 0.0)),
        bodies: [
            Pool(seed: (2.5, -19.5), surface_level: 13.3),
            Pool(seed: (24.0, 1.0), surface_level: 2.5),
            // Out of the crag's east face into the tarn.
            Spring(position: (-5.0, 19.5, -19.5), direction: (7.0, 0.0, 0.0), discharge: 3.0),
            // Out of the north cliff into the sea.
            Spring(position: (-6.0, 8.0, -28.5), direction: (0.0, 0.0, -2.5), discharge: 1.0),
        ],
    )),
)
