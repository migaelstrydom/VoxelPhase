// Room F1 — drop the ball (docs/GAME_DESIGN.md, Finding out).
//
// The player starts on a wide island with two holes in it and a ball beside
// each. Under one hole, 5 m down and out of sight under the island, is a
// small island with the exit; under the other is nothing. Walking off the
// edge falls past the small island, which lies 8 m in from every edge. Drop a
// ball down each hole: one bounces back up into sight, and the other is
// gone. Jump down the first.
//
//               N (+z)
//   ┌───────────────────────────────┐
//   │          upper island,        │  z = 32, top 14, 2.5 m thick
//   │          x 8–32               │
//   │       ○ ●            ● ○      │  holes at x 16 and 24, z 20
//   │      ┌─────┐                  │  balls beside them
//   │      │lower│  under, top 9    │
//   │      └─────┘                  │
//   │              ☺                │  z = 8
//   └───────────────────────────────┘
Level(
    name: "F1 Drop the Ball",

    segments: [
        (
            name: "room",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -8.0, 0.0), max: (40.0, 24.0, 40.0)),
                base_height: -6.0,
                material_layers: [
                    (depth: 0.5,   material: Grass),
                    (depth: 3.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [],

                volumes: [
                    // The upper island, where the player starts.
                    Platform(center: (20.0, 14.0, 20.0), half_extents: (12.0, 12.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 13.0, 20.0), half_extents: (12.0, 12.0), thickness: 1.5, material: Dirt),
                    // The holes.
                    Shaft(center: (16.0, 20.0), from_y: 11.0, to_y: 15.0, radius: 1.2),
                    Shaft(center: (24.0, 20.0), from_y: 11.0, to_y: 15.0, radius: 1.2),
                    // The lower island, under the west hole.
                    Platform(center: (16.0, 9.0, 20.0), half_extents: (4.0, 4.0), thickness: 1.0, material: Grass),
                    Platform(center: (16.0, 8.0, 20.0), half_extents: (4.0, 4.0), thickness: 1.0, material: Dirt),
                ],
            ),

            anchors: [],
            objects: [
                BeachBall(pos: (13.8, 14.52, 20.0)),
                BeachBall(pos: (26.2, 14.52, 20.0)),
                Goal(pos: (16.0, 9.0, 20.0), radius: 2.5, required_gems: 0),
            ],
        ),
    ],

    placements: [
        Root(segment: "room", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    connections: [],

    player_spawn: (20.0, 15.0, 11.0),
)
