// Room M1 — ride across (docs/GAME_DESIGN.md, Machines): the first platform.
//
// Two islands 18 m apart, past a running jump. A platform shuttles between
// them. Board it as it docks and ride it over.
//
//               N (+z)
//         ┌───────────┐
//         │     ◎     │  far island, z 32–40, top 10
//         └───────────┘
//              ▭        platform, z 15.6 ↔ 30.4
//         ┌───────────┐
//         │     ☺     │  near island, z 4–14, top 10
//         └───────────┘
//         x 14       26      floor far below at -6
Level(
    name: "M1 Ride Across",

    segments: [
        (
            name: "room",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -8.0, 0.0), max: (40.0, 24.0, 44.0)),
                base_height: -6.0,
                material_layers: [
                    (depth: 0.5,   material: Grass),
                    (depth: 3.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [],

                volumes: [
                    Platform(center: (20.0, 10.0, 9.0), half_extents: (6.0, 5.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 9.0), half_extents: (6.0, 5.0), thickness: 2.0, material: Dirt),
                    Platform(center: (20.0, 10.0, 36.0), half_extents: (6.0, 4.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 36.0), half_extents: (6.0, 4.0), thickness: 2.0, material: Dirt),
                ],
            ),

            anchors: [],
            objects: [
                MovingPlatform(
                    waypoints: [(20.0, 9.85, 15.6), (20.0, 9.85, 30.4)],
                    half_extents: (1.5, 0.15, 1.5),
                    density: 300.0,
                ),
                Goal(pos: (20.0, 10.0, 37.0), radius: 2.0, required_gems: 0),
            ],
        ),
    ],

    placements: [
        Root(segment: "room", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    connections: [],

    player_spawn: (20.0, 11.0, 6.0),
)
