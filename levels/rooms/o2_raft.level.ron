// Room O2 — water lifts an object (docs/GAME_DESIGN.md, Objects): the first
// combination.
//
// The exit is an island hanging 4 m over the floor: past a jump's reach from
// anywhere dry. Beside it a round well 6 m deep holds a wooden crate 2 m on a
// side, its top 4 m down. On a terrace to the west a small reservoir is held
// by a sand dam, and a channel runs from the dam to the well. Hole the dam:
// the water runs down the channel and fills the well, and the crate floats
// up it, guided by its walls, to stand with its top about 2 m under the
// island's lip. On the crate, that is a jump.
//
// The crate is in a well because a crate floated in open water drifts with
// the flood's current: in a pit it was carried to the far wall. The reservoir
// holds what fills the well and the channel to just under the floor, so the
// crate stays in the well's grip.
//
// The brazier stands on the island.
//
//               N (+z)
//   ┌────────┬────────────────────────────┐
//   │        │                            │  floor at 10
//   │ RES-   │            ┌───┐           │  island: x 14–18, z 21.6–25.6,
//   │ ERV-   │            │ ◎ │           │    top at 14, 1 m thick
//   │ OIR    ▐═channel═══ (▣) well        │  well: round, r 1.6, floor at 4
//   │ 11     │                            │  channel floor at 9
//   │ 16     │                            │  dam: sand 1 m, x 7.5–8.5
//   │        │         ☺ spawn            │
//   └────────┴────────────────────────────┘
//    x 0     8                            32
Level(
    name: "O2 Raft",

    segments: [
        (
            name: "room",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -8.0, 0.0), max: (32.0, 24.0, 32.0)),
                base_height: 10.0,
                material_layers: [
                    (depth: 0.5,   material: Grass),
                    (depth: 3.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [
                    // The terrace to the west.
                    Plateau(min: (0.0, 0.0), max: (8.0, 32.0), height: 16.0),
                    // The reservoir's basin, its floor a metre above the room's.
                    Plateau(min: (2.0, 14.0), max: (6.0, 26.0), height: 11.0),
                    // The gap in the terrace's wall that the dam fills.
                    Plateau(min: (6.0, 17.0), max: (8.0, 23.0), height: 11.0),
                    // The channel from the dam to the well, a metre wide.
                    Plateau(min: (8.0, 19.5), max: (15.0, 20.5), height: 9.0),
                ],

                volumes: [
                    // The dam: sand 1 m thick on the gap's room side.
                    Platform(center: (8.0, 16.0, 20.0), half_extents: (0.5, 4.0), thickness: 6.5, material: Sand),
                    // The well.
                    Shaft(center: (16.0, 20.0), from_y: 4.0, to_y: 11.0, radius: 1.6),
                    // The island, hanging just north of the well.
                    Platform(center: (16.0, 14.0, 23.6), half_extents: (2.0, 2.0), thickness: 1.0),
                ],
            ),

            anchors: [],
            objects: [
                Crate(pos: (16.0, 5.05, 20.0), size: 1.0),
                Brazier(pos: (16.0, 14.0, 23.6), radius: 1.5),
            ],
        ),
    ],

    placements: [
        Root(segment: "room", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    connections: [],

    player_spawn: (16.0, 11.0, 6.0),

    water: Some((
        bodies: [
            Pool(seed: (4.0, 20.0), surface_level: 12.1),
        ],
    )),
)
