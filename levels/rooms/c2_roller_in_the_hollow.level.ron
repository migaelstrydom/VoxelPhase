// Room C2 — strand a roller (docs/GAME_DESIGN.md, Creatures).
//
// The way on crosses a hollow 3 m deep and 5 m wide, 18 m long so that no
// running jump clears it, and a roller
// lives in the hollow. It charges what it sees, and the hollow's sides are
// open to the sky: a hit throws the player off the island. Crater the
// hollow's floor in its path: a roller in a hole cannot climb out.
//
// The hollow's walls are lips a jump catches.
//
//   side view, looking west
//   ☺                                  ◎
//   ══════════╗                    ╔══════════  top 10
//             ║       ●            ║
//             ╚════════════════════╝            hollow, top 7, x 17.5–22.5
//   z 2     z 11                 z 29      z 38    floor far below at -6
Level(
    name: "C2 Roller in the Hollow",

    segments: [
        (
            name: "room",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -8.0, 0.0), max: (40.0, 24.0, 40.0)),
                base_height: -6.0,
                material_layers: [
                    (depth: 0.5,   material: Grass),
                    (depth: 3.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [],

                volumes: [
                    // The near and far ends, run down to the hollow's
                    // underside so that its walls are earth.
                    Platform(center: (20.0, 10.0, 6.5), half_extents: (4.0, 4.5), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 6.5), half_extents: (4.0, 4.5), thickness: 4.0, material: Dirt),
                    Platform(center: (20.0, 10.0, 33.5), half_extents: (4.0, 4.5), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 33.5), half_extents: (4.0, 4.5), thickness: 4.0, material: Dirt),
                    // The hollow's floor, run half a metre into each end.
                    Platform(center: (20.0, 7.0, 20.0), half_extents: (2.5, 9.5), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 6.0, 20.0), half_extents: (2.5, 9.5), thickness: 1.0, material: Dirt),
                ],
            ),

            anchors: [],
            objects: [
                Roller(pos: (20.0, 21.0)),
                Goal(pos: (20.0, 10.0, 35.0), radius: 2.0, required_gems: 0),
            ],
        ),
    ],

    placements: [
        Root(segment: "room", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    connections: [],

    player_spawn: (20.0, 11.0, 4.0),
)
