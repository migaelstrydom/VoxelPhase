// Room M4 — a platform carries an object (docs/GAME_DESIGN.md, Machines).
//
// A platform shuttles between two islands 18 m apart. The exit is on a small
// island hanging past the far one, its top 4.5 m up: past a jump. A crate
// stands on the near island. Get it onto the platform as it docks, ride over
// with it, and push it under the exit island's lip.
//
// The goal's point is 2 m over the exit island.
//
//               N (+z)
//         ┌───────────┐
//         │     ◎     │  exit island, z 40.5–44.5, top 14.5
//         └───────────┘
//         ┌───────────┐
//         │           │  far island, z 32–40, top 10
//         └───────────┘
//              ▭        platform, z 15.6 ↔ 30.4
//         ┌───────────┐
//         │   ▣  ☺    │  near island, z 4–14, top 10
//         └───────────┘
Level(
    name: "M4 Crate on the Platform",

    segments: [
        (
            name: "room",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -8.0, 0.0), max: (40.0, 24.0, 48.0)),
                base_height: -6.0,
                material_layers: [
                    (depth: 0.5,   material: Grass),
                    (depth: 3.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [],

                volumes: [
                    Platform(center: (20.0, 10.0, 9.0), half_extents: (6.0, 5.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 9.0), half_extents: (6.0, 5.0), thickness: 2.0, material: Dirt),
                    Platform(center: (20.0, 10.0, 36.0), half_extents: (6.0, 4.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 9.0, 36.0), half_extents: (6.0, 4.0), thickness: 2.0, material: Dirt),
                    // The exit island, half a metre past the far one.
                    Platform(center: (20.0, 14.5, 42.5), half_extents: (4.0, 2.0), thickness: 1.0, material: Grass),
                    Platform(center: (20.0, 13.5, 42.5), half_extents: (4.0, 2.0), thickness: 1.0, material: Dirt),
                ],
            ),

            anchors: [],
            objects: [
                MovingPlatform(
                    waypoints: [(20.0, 9.85, 15.6), (20.0, 9.85, 30.4)],
                    half_extents: (1.5, 0.15, 1.5),
                    density: 300.0,
                ),
                Crate(pos: (17.0, 10.8, 9.0), size: 0.8),
                Goal(pos: (20.0, 16.5, 42.5), radius: 1.5, required_gems: 0),
            ],
        ),
    ],

    placements: [
        Root(segment: "room", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    connections: [],

    player_spawn: (21.0, 11.0, 6.0),
)
