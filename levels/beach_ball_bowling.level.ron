// Beach Ball Bowling — Easy difficulty.
// A wide-open playground to learn the basics. Knock beach balls into
// crate towers, push things around, and reach the goal on a gentle hill.
//
// Layout (top-down):
//
//   [Spawn]       [Crate Alley]        [Goal Hill]
//    (0,0)         (10-20, z)           (28, 0)
//              scattered towers
//              + beach balls
Level(
    name: "Beach Ball Bowling",
    world_size: 64.0,
    voxel_size: 1.0,

    terrain: Terrain(
        base_height: -2.0,
        material_layers: [
            (depth: 1.0,  material: Grass),
            (depth: 3.0,  material: Dirt),
            (depth: 999.0, material: Rock),
        ],

        features: [
            // Big flat play area
            Plateau(min: (-12.0, -15.0), max: (24.0, 15.0), height: 0.0),

            // Goal sits on a gentle hill — easy to reach
            Hill(center: (28.0, 0.0), radius: 8.0, height: 3.0),

            // Decorative hills around the edges
            Hill(center: (-18.0, 10.0), radius: 7.0, height: 4.0),
            Hill(center: (-15.0, -12.0), radius: 6.0, height: 3.0),
            Hill(center: (20.0, 20.0), radius: 9.0, height: 2.5),

            // Slight roughness for visual interest
            TerrainRoughness(frequency: 0.08, amplitude: 0.2, octaves: 2, seed: 101),
        ],
    ),

    player_spawn: (-8.0, 2.0, 0.0),

    objects: [
        // === BOWLING LANES ===
        // Lane 1 — easy pin triangle
        Tower(
            base: (14.0, 0.5, -6.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 3,
            density: 20.0,
        ),
        Tower(
            base: (14.0, 0.5, -5.0),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 3,
            density: 20.0,
        ),
        Tower(
            base: (14.5, 0.5, -5.5),
            box_half_extents: (0.4, 0.4, 0.4),
            count: 4,
            density: 20.0,
        ),

        // Lane 2 — taller tower
        Tower(
            base: (14.0, 0.5, 1.0),
            box_half_extents: (0.5, 0.3, 0.5),
            count: 6,
            density: 25.0,
        ),

        // Lane 3 — brick wall
        BoxWall(
            base: (14.0, 0.5, 6.0),
            box_half_extents: (0.5, 0.4, 0.4),
            columns: 3,
            rows: 3,
            density: 20.0,
            stagger: true,
        ),

        // === BEACH BALLS ===
        // Plenty of balls to kick at the targets
        BeachBall(pos: (2.0, 1.5, -6.0)),
        BeachBall(pos: (3.0, 1.5, -5.0)),
        BeachBall(pos: (2.0, 1.5, 1.0)),
        BeachBall(pos: (3.5, 1.5, 2.0)),
        BeachBall(pos: (2.0, 1.5, 6.0)),
        BeachBall(pos: (3.0, 1.5, 7.0)),

        // Extra balls near spawn to experiment with
        BeachBall(pos: (-5.0, 1.5, -3.0)),
        BeachBall(pos: (-5.0, 1.5, 3.0)),

        // === STEPPING STONES to goal hill ===
        Crate(pos: (20.0, 0.5, 0.0), size: 0.6),
        Crate(pos: (22.0, 0.5, 1.0), size: 0.6),
        HeavyCrate(pos: (24.0, 0.5, 0.0), size: 0.8),
    ],

)
