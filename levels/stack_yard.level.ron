                Box(pos: (39.5, 8.25, 16.0), half_extents: (2.0, 0.25, 0.6), style: Stone, density: 1000.0),
                Tower(base: (46.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 4),
