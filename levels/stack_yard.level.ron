                BeachBall(pos: (51.5, 3.0, 75.5)), BeachBall(pos: (51.5, 3.0, 76.5)), BeachBall(pos: (51.5, 3.0, 77.5)), BeachBall(pos: (51.5, 3.0, 78.5)),
