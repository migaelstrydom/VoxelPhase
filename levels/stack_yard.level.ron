                Box(pos: (47.5, 8.25, 16.0), half_extents: (2.0, 0.25, 0.6), style: Metal, density: 5000.0),

                // Mixed: crates, a plank, a heavy crate, a light crate on top.
                Stack(base: (56.0, 4.0, 16.0), items: [
