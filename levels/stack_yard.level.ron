// Stack Yard — a test level for stacking physics, laid out to play-test
// stacks and arches.
//
// West, a dead-flat yard: towers of equal crates, heavy blocks on light
// columns at 10:1 and 100:1, slabs on columns, jenga, a pyramid, a wall,
// arches, trilithons, a temple, dominoes, a card stack and ice.
//
// East, rolling ground. Every structure there stands on a flat pad of its
// own, set into or above the bumps, because every body starts asleep exactly
// as authored and a stack on a slope would hang tilted until touched. What
// it tests is what happens next: knocks and collapses that land on the
// bumps, and one slab carried by columns standing on ground a metre apart.
//
//        x 8 ─────────── flat yard ─────────── 64 │ 68 ──── rolling field ──── 124
//   z 16   towers · heavy-on-light · slabs        │ tower · 100:1 · jenga · stepped slab
//   z 34   jenga · pyramid · wall                 │ arch · trilithon · pyramid
//   z 54   arches · trilithons                    │ wall · gold on tower · tall jenga
//   z 75   ball pit · temple                      │
//   z 104  dominoes · card stack · ice            │ arch over a crater · crate block in a crater
//
// Crates are 1 m cubes of 50 kg. The 100:1 blocks are 1 m cubes at
// 5000 kg/m³, the ratio the mass-ratio sweep measures.
Level(
    name: "Stack Yard",

    segments: [
        (
            name: "yard",

            terrain: Terrain(
                voxel_size: 0.5,
                bounds: (min: (0.0, -32.0, 0.0), max: (128.0, 32.0, 128.0)),
                base_height: 4.0,
                material_layers: [
                    (depth: 1.0,   material: Grass),
                    (depth: 4.0,   material: Dirt),
                    (depth: 999.0, material: Rock),
                ],

                features: [
                    // ── The rolling field: everywhere, then flattened in the west. ──
                    TerrainRoughness(frequency: 0.12, amplitude: 1.1, octaves: 3, seed: 61),
                    Hill(center: (118.0, 78.0), radius: 7.0, height: 1.8),

                    // ── The jumble crater: gentle walls, a flat floor 3.5 m down. ──
                    Crater(center: (108.0, 100.0), radius: 10.0, depth: 3.5),
                    Plateau(min: (105.0, 97.0), max: (111.0, 103.0), height: 0.5),

                    // ── The arch crater. ────────────────────────────────────
                    // A flat rim at 4.0 and a round pit. Along the arch's line a
                    // ledge at 0.0 takes the abutments, and under the arch the
                    // pit goes on down. The rim stands level with the ring's
                    // flanks where they lean at about 50°: step across the gap
                    // from the rim onto the ring and walk over.
                    Plateau(min: (74.0, 94.0), max: (94.0, 114.0), height: 4.0),
                    Crater(center: (84.0, 104.0), radius: 6.0, depth: 6.0),
                    Plateau(min: (78.8, 102.0), max: (89.2, 106.0), height: 0.0),
                    Plateau(min: (81.0, 102.0), max: (87.0, 106.0), height: -2.0),

                    // ── The flat yard. ──────────────────────────────────────
                    Plateau(min: (4.0, 4.0), max: (66.0, 124.0), height: 4.0),

                    // ── The ball pit, in the flat yard: 1.5 m deep. ──────────
                    Plateau(min: (48.0, 70.0), max: (58.0, 80.0), height: 2.5),

                    // ── Pads in the field, one per structure. ───────────────
                    // Absolute heights: a pad below the bumps is a pit, one
                    // above them a plinth.
                    Plateau(min: (73.0, 13.0), max: (79.0, 19.0), height: 4.0),
                    Plateau(min: (81.0, 13.0), max: (87.0, 19.0), height: 4.4),
                    Plateau(min: (91.0, 13.0), max: (97.0, 19.0), height: 3.7),
                    // The stepped pair under one slab: a metre apart.
                    Plateau(min: (101.0, 13.0), max: (106.0, 19.0), height: 4.0),
                    Plateau(min: (106.0, 13.0), max: (111.0, 19.0), height: 5.0),

                    Plateau(min: (75.0, 31.0), max: (85.0, 37.0), height: 4.2),
                    Plateau(min: (93.0, 31.0), max: (99.0, 37.0), height: 3.8),
                    Plateau(min: (103.0, 29.0), max: (115.0, 41.0), height: 4.3),

                    Plateau(min: (74.0, 50.0), max: (90.0, 58.0), height: 4.0),
                    Plateau(min: (97.0, 51.0), max: (103.0, 57.0), height: 4.5),
                    Plateau(min: (109.0, 51.0), max: (115.0, 57.0), height: 4.0),
                ],
            ),

            objects: [
                // ── Flat yard, z 16: columns ───────────────────────────────
                // Equal crates, 4, 8 and 12 high.
                Tower(base: (10.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 4),
                Tower(base: (13.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 8),
                Tower(base: (16.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 12),

                // Heavy on light: 100:1 on 3, 100:1 on 8, 10:1 on 8.
                Tower(base: (21.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 3),
                Box(pos: (21.0, 7.5, 16.0), half_extents: (0.5, 0.5, 0.5), style: Metal, density: 5000.0),
                Tower(base: (24.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 8),
