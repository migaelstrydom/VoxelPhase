                VoussoirArch(base: (12.0, 4.0, 54.0)),
                VoussoirArch(base: (26.0, 4.0, 54.0), inner_radius: 3.5, num_voussoirs: 15),
                Trilithon(pos: (40.0, 4.0, 54.0)),
                Trilithon(pos: (46.0, 4.0, 54.0), gap: 2.0, upright_half_height: 1.8),
                Trilithon(pos: (54.0, 4.0, 54.0), yaw: 90.0),

                // ── Flat yard, z 80: the temple ────────────────────────────
                Temple(pos: (30.0, 4.0, 80.0)),

                // ── Flat yard, z 75: the ball pit ──────────────────────────
                // Two layers of beach balls, the second in the first's hollows.
                BeachBall(pos: (49.5, 3.0, 71.5)), BeachBall(pos: (49.5, 3.0, 72.5)), BeachBall(pos: (49.5, 3.0, 73.5)), BeachBall(pos: (49.5, 3.0, 74.5)),
                BeachBall(pos: (49.5, 3.0, 75.5)), BeachBall(pos: (49.5, 3.0, 76.5)), BeachBall(pos: (49.5, 3.0, 77.5)), BeachBall(pos: (49.5, 3.0, 78.5)),
                BeachBall(pos: (50.5, 3.0, 71.5)), BeachBall(pos: (50.5, 3.0, 72.5)), BeachBall(pos: (50.5, 3.0, 73.5)), BeachBall(pos: (50.5, 3.0, 74.5)),
                BeachBall(pos: (50.5, 3.0, 75.5)), BeachBall(pos: (50.5, 3.0, 76.5)), BeachBall(pos: (50.5, 3.0, 77.5)), BeachBall(pos: (50.5, 3.0, 78.5)),
