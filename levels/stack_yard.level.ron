                Tower(base: (33.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 6),
                MetalCube(pos: (33.0, 10.4, 16.0), metal: Tungsten, size: 0.8),

                // Slabs on two columns: 2.4 t (about 50:1) and 12 t (240:1).
                Tower(base: (38.0, 4.0, 16.0), box_half_extents: (0.5, 0.5, 0.5), count: 4),
