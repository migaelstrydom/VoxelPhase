                BeachBall(pos: (51.0, 3.707, 77.0)), BeachBall(pos: (51.0, 3.707, 78.0)), BeachBall(pos: (52.0, 3.707, 72.0)), BeachBall(pos: (52.0, 3.707, 73.0)),
                BeachBall(pos: (52.0, 3.707, 74.0)), BeachBall(pos: (52.0, 3.707, 75.0)), BeachBall(pos: (52.0, 3.707, 76.0)), BeachBall(pos: (52.0, 3.707, 77.0)),
