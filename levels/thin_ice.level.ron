// Thin Ice — a frozen tarn in a limestone bowl, crossed on floes that float.
//
// The engine's water carries real buoyancy and its ice is authored at the
// density of ice, so a slab of it floats with a hand's breadth of freeboard and
// tips when you land on its edge. That one fact is the whole level: the way
// across the tarn is a chain of loose floes, and every landing moves the floor.
//
//   west beach ─▶ floes ─▶ igloo island ─▶ causeway ─▶ east beach ─▶ stair ─▶ shelf
//      spawn      (drift)   gems, critter   ice wall                 peepers   GOAL
//
// Rules the geometry obeys:
//   * Nowhere is the player trapped. Every shore is terraced in ≤ 1.6 m steps
//     from the lake bed (3.0) to dry ground, so falling in costs a wade, not
//     the run.
//   * Water sits at 5.0. Floes are 1.2 m thick and draw 1.1 m, so their decks
//     ride just above the surface and clear the bed by most of a metre.
//   * Nothing asks for more than a 2 m rise or a 4 m gap.
Level(
    name: "Thin Ice",

    segments: [
        (
            name: "tarn",

            terrain: Terrain(
                voxel_size: 1.0,
                bounds: (min: (0.0, -32.0, 0.0), max: (128.0, 32.0, 96.0)),
                base_height: 7.0,
                material_layers: [
                    (depth: 1.0,   material: Limestone),
                    (depth: 3.0,   material: Ite),
                    (depth: 999.0, material: Slate),
                ],

                features: [
                    TerrainRoughness(frequency: 0.05, amplitude: 0.6, octaves: 3, seed: 7),

                    // The spawn ridge: hides the tarn until you crest it.
                    Hill(center: (8.0, 48.0), radius: 14.0, height: 3.0),

                    // ── The tarn. Bed at 3.0, water at 5.0. ──────────────
                    Plateau(min: (28.0, 14.0), max: (100.0, 82.0), height: 3.0),

                    // West beach: two terraces down to the bed.
                    Plateau(min: (28.0, 14.0), max: (30.0, 82.0), height: 5.4),
                    Plateau(min: (30.0, 14.0), max: (32.0, 82.0), height: 4.4),

                    // East beach, mirrored.
                    Plateau(min: (96.0, 14.0), max: (98.0, 82.0), height: 4.4),
                    Plateau(min: (98.0, 14.0), max: (100.0, 82.0), height: 5.4),

                    // ── The island: three terraces up to the igloo pad. ──
                    Plateau(min: (56.0, 32.0), max: (84.0, 64.0), height: 4.2),
                    Plateau(min: (58.0, 34.0), max: (82.0, 62.0), height: 5.4),
                    Plateau(min: (60.0, 36.0), max: (80.0, 60.0), height: 6.0),

                    // The causeway east off the island, awash by half a metre.
                    Plateau(min: (82.0, 45.0), max: (100.0, 51.0), height: 5.6),

                    // ── The shelf: 7 m above the east shore. ─────────────
                    Plateau(min: (114.0, 28.0), max: (128.0, 68.0), height: 14.0),
                ],

                volumes: [
                    // Fixed stepping stones among the floes: the floes drift,
                    // these do not, so the crossing always has a way to reset.
                    Platform(center: (43.0, 5.5, 48.0), half_extents: (1.2, 1.2), thickness: 3.0),
                    Platform(center: (56.0, 5.5, 48.0), half_extents: (1.2, 1.2), thickness: 3.0),
                    // The rock the off-route gem sits on.
                    Platform(center: (44.0, 5.6, 34.0), half_extents: (1.2, 1.2), thickness: 3.0),

                    // The way up to the shelf: seven risers of a metre, which
                    // the player walks rather than jumps.
                    Staircase(
                        from: (101.0, 7.0, 48.0),
                        to: (114.0, 14.0, 48.0),
                        width: 6.0,
                        steps: 7,
                        thickness: 2.0,
                        material: Limestone,
                    ),
                ],
            ),

            objects: [
                // ── The floe crossing ──────────────────────────────────────
                // Authored just above the surface; buoyancy settles them. Two
                // metre gaps between decks, the same as the fixed stones.
                IceBox(pos: (34.5, 5.3, 47.0), half_extents: (1.5, 0.6, 1.5), yaw: 8.0),
                IceBox(pos: (38.0, 5.3, 49.5), half_extents: (1.5, 0.6, 1.5), yaw: -12.0),
                IceBox(pos: (48.0, 5.3, 46.5), half_extents: (1.5, 0.6, 1.5), yaw: 20.0),
                IceBox(pos: (52.0, 5.3, 49.5), half_extents: (1.5, 0.6, 1.5), yaw: -5.0),

                // The off-route pair, north-west, toward the gem rock.
                IceBox(pos: (36.0, 5.3, 41.0), half_extents: (1.5, 0.6, 1.5), yaw: 30.0),
                IceBox(pos: (40.0, 5.3, 37.5), half_extents: (1.5, 0.6, 1.5), yaw: -25.0),
                Gem(pos: (44.0, 6.4, 34.0), colour: Some((0.5, 0.9, 1.0))),

                // Something to watch sink and not sink: a beach ball floats
                // high, a crate floats low, a heavy crate does not float at
                // all. Kick them in.
                BeachBall(pos: (31.0, 6.0, 52.0)),
                Crate(pos: (30.0, 6.0, 44.0), size: 0.5),

                // ── The island ─────────────────────────────────────────────
                // The village. Doorways face the beach you arrive on.
                Igloo(pos: (64.0, 6.0, 41.0), yaw: 180.0),
                Igloo(pos: (65.0, 6.0, 55.0), yaw: 180.0),
                Igloo(pos: (76.0, 6.0, 56.0), radius: 3.0, yaw: -90.0),

                // One gem is indoors; the door tells you which house.
                Gem(pos: (64.0, 6.8, 41.0), colour: Some((1.0, 0.8, 0.3))),

                // One gem is on the big dome, higher than a standing jump.
                // The crates beside it get you onto the ice, and the ice does
                // the rest — you take it on the way down.
                Gem(pos: (76.0, 10.3, 56.0), colour: Some((1.0, 0.8, 0.3))),
                Stack(base: (72.3, 6.0, 56.0), items: [Crate(size: 0.7), Crate(size: 0.7)]),

                // Loose ice around the village, for kicking into the tarn.
                IceBox(pos: (61.5, 6.4, 50.0)),
                IceBox(pos: (62.8, 6.4, 51.2)),
                IceBox(pos: (61.0, 6.4, 52.4)),
                IceBox(pos: (70.0, 6.6, 46.0), half_extents: (0.6, 0.6, 0.6), yaw: 35.0),

                // It heals you, and on ice it is faster to turn than you are.
                HeartCritter(pos: (71.0, 49.0)),

                // Sunk in the tarn north of the island, seen glowing through
                // the water. A wade from the island's north terrace.
                Gem(pos: (70.0, 3.7, 72.0), colour: Some((0.5, 0.9, 1.0))),

                // ── The causeway ───────────────────────────────────────────
                // A wall of ice bricks across the only dry way east. Loose:
                // walk into it and it goes into the water in pieces.
                IceWall(base: (91.0, 5.6, 48.0), columns: 6, rows: 5, yaw: 90.0),

                // ── The shelf ──────────────────────────────────────────────
                // Two stalkers hold the shelf. Fragile, and the ice pond
                // behind them is not kind to anything on stilts.
                Peeper(pos: (118.0, 40.0)),
                Peeper(pos: (120.0, 58.0)),
                Gem(pos: (124.0, 14.7, 34.0), colour: Some((1.0, 0.5, 0.8))),

                Trilithon(pos: (121.0, 14.0, 48.0), yaw: 90.0),
                Goal(pos: (121.0, 14.0, 48.0), required_gems: 3),
            ],
        ),
    ],

    placements: [
        Root(segment: "tarn", origin: (0.0, 0.0, 0.0), yaw: 0.0),
    ],

    // On the far side of the spawn ridge, so the tarn is a reveal.
    player_spawn: (6.0, 10.6, 48.0),

    water: Some((
        ocean_level: None,
        bodies: [
            // The plain sits at 7 ± 0.6, two metres over the surface. A pool
            // claims any cell with a sample at or under its level, so the
            // margin between the water and the ground around it has to
            // clear the roughness with room to spare or the fill escapes.
            Pool(seed: (45.0, 60.0), surface_level: 5.0),
        ],
    )),
)
