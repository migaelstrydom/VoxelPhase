#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image3D fieldSrc;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D fieldDst;
layout(set = 0, binding = 2, rgba16f) uniform readonly image3D velSrc;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D velDst;

layout(push_constant) uniform FireSimParams {
    float dt;
    float buoyancy_strength;
    float cooling_rate;
    float combustion_rate;
    float burn_rate;
    float turbulence_amplitude;
    float turbulence_frequency;
    float smoke_production;
    float time;
    int jacobi_iteration;
} params;

// Trilinear sample helpers. GLSL image function parameters require matching
// format qualifiers, so we provide one function per source image.

vec4 sampleField(vec3 uvw) {
    ivec3 size = imageSize(fieldSrc);
    vec3 texel = uvw * vec3(size) - 0.5;
    ivec3 t0 = ivec3(floor(texel));
    vec3 f = fract(texel);

    ivec3 lo = clamp(t0, ivec3(0), size - 1);
    ivec3 hi = clamp(t0 + 1, ivec3(0), size - 1);

    vec4 c000 = imageLoad(fieldSrc, ivec3(lo.x, lo.y, lo.z));
    vec4 c100 = imageLoad(fieldSrc, ivec3(hi.x, lo.y, lo.z));
    vec4 c010 = imageLoad(fieldSrc, ivec3(lo.x, hi.y, lo.z));
    vec4 c110 = imageLoad(fieldSrc, ivec3(hi.x, hi.y, lo.z));
    vec4 c001 = imageLoad(fieldSrc, ivec3(lo.x, lo.y, hi.z));
    vec4 c101 = imageLoad(fieldSrc, ivec3(hi.x, lo.y, hi.z));
    vec4 c011 = imageLoad(fieldSrc, ivec3(lo.x, hi.y, hi.z));
    vec4 c111 = imageLoad(fieldSrc, ivec3(hi.x, hi.y, hi.z));

    vec4 c00 = mix(c000, c100, f.x);
    vec4 c10 = mix(c010, c110, f.x);
    vec4 c01 = mix(c001, c101, f.x);
    vec4 c11 = mix(c011, c111, f.x);

    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

vec4 sampleVelocity(vec3 uvw) {
    ivec3 size = imageSize(velSrc);
    vec3 texel = uvw * vec3(size) - 0.5;
    ivec3 t0 = ivec3(floor(texel));
    vec3 f = fract(texel);

    ivec3 lo = clamp(t0, ivec3(0), size - 1);
    ivec3 hi = clamp(t0 + 1, ivec3(0), size - 1);

    vec4 c000 = imageLoad(velSrc, ivec3(lo.x, lo.y, lo.z));
    vec4 c100 = imageLoad(velSrc, ivec3(hi.x, lo.y, lo.z));
    vec4 c010 = imageLoad(velSrc, ivec3(lo.x, hi.y, lo.z));
    vec4 c110 = imageLoad(velSrc, ivec3(hi.x, hi.y, lo.z));
    vec4 c001 = imageLoad(velSrc, ivec3(lo.x, lo.y, hi.z));
    vec4 c101 = imageLoad(velSrc, ivec3(hi.x, lo.y, hi.z));
    vec4 c011 = imageLoad(velSrc, ivec3(lo.x, hi.y, hi.z));
    vec4 c111 = imageLoad(velSrc, ivec3(hi.x, hi.y, hi.z));

    vec4 c00 = mix(c000, c100, f.x);
    vec4 c10 = mix(c010, c110, f.x);
    vec4 c01 = mix(c001, c101, f.x);
    vec4 c11 = mix(c011, c111, f.x);

    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(fieldSrc);

    if (any(greaterThanEqual(pos, size))) return;

    vec3 uvw = (vec3(pos) + 0.5) / vec3(size);

    // Read velocity at this voxel
    vec4 vel = imageLoad(velSrc, pos);
    vec3 v = vel.xyz;

    // Semi-Lagrangian backtrace: find where this fluid came from
    vec3 backtraceUVW = uvw - v * params.dt / vec3(size);
    backtraceUVW = clamp(backtraceUVW, vec3(0.0), vec3(1.0));

    // Sample field and velocity at backtraced position
    vec4 advectedField = sampleField(backtraceUVW);
    vec4 advectedVel = sampleVelocity(backtraceUVW);

    imageStore(fieldDst, pos, advectedField);
    imageStore(velDst, pos, advectedVel);
}
