// Stepping stones over a void, zigzagged either side of the path, the third
// tilted across it. Parameters and layout are left at their defaults.
TraversalScene(
    ground: Authored(AuthoredGround(
        base: None,
        shapes: [
            Shape(form: Block(from: -1.0, to: 0.4, top: 0.0), support: Static),
            Shape(form: Block(from: 0.8, to: 1.1, top: 0.0), across: Some((0.05, 0.3)), support: Static),
            Shape(form: Block(from: 1.5, to: 1.8, top: 0.05), across: Some((-0.3, -0.05)), support: Static),
            Shape(form: Block(from: 2.2, to: 2.5, top: 0.0, tilt: 0.4), across: Some((0.0, 0.25)), support: Loose(mass: 40.0, asleep: true)),
            Shape(form: Block(from: 2.9, to: 4.0, top: 0.0), support: Static),
        ],
    )),
    body: BodyState(s: 0.0, z: 0.25, speed: 3.0, climb: 0.0),
    lead: LeftFoot,
    intent: Intent(speed: 3.0),
)
